<https://purl.org/oquo-oquare>
        a                              owl:Ontology ;
        dc:contributor                 <https://orcid.org/0000-0002-7558-2880> , <https://orcid.org/0000-0001-6233-6384> , <https://orcid.org/0000-0003-0201-3115> ;
        dc:creator                     <https://orcid.org/0000-0001-6233-6384> ;
        dc:description                 "OQUO module that defines the metrics of OQuaRE (Ontology Quality Requirements and Evaluation), a framework for evaluating the quality of ontologies based on the SQuaRE (ISO/IEC 25000) standard. The module defines 20 OQuaRE metrics, most of them adapted from software engineering metrics to the structure of ontologies (e.g. depth of subsumption hierarchy, lack of cohesion in methods, tangledness or relationship richness), and associates them, positively or negatively, with the characteristics and subcharacteristics of the OQuaRE quality model that they measure. For 18 of these metrics, the module defines their raw scales and the conversions of these raw scales into the OQuaRE five categories scale by means of cardinal to ordinal scale conversions."@en ;
        dc:publisher                   "Universidad de Murcia" ;
        dc:source                      <https://doi.org/10.3316/informit.265844843145749> ;
        dc:title                       "OQUO OQuaRE metrics module"@en ;
        terms:created                  "2025-01-11"^^xsd:date ;
        terms:license                  <https://opensource.org/licenses/MIT> ;
        vann:preferredNamespacePrefix  "oquo-oquare" ;
        vann:preferredNamespaceUri     "https://purl.org/oquo-oquare#" ;
        schema:codeRepository          <https://github.com/tecnomod-um/oquare> ;
        owl:versionIRI                 <https://purl.org/oquo-oquare/v2.0.2> .

