<https://purl.org/oquo-oquare-qm>
        a                              owl:Ontology ;
        dc:contributor                 <https://orcid.org/0000-0003-0201-3115> , <https://orcid.org/0000-0003-0487-308X> , <https://orcid.org/0000-0003-3641-7548> , <https://orcid.org/0009-0008-4226-2582> , <https://orcid.org/0000-0002-7558-2880> , <https://orcid.org/0000-0001-6233-6384> ;
        dc:creator                     <https://orcid.org/0000-0003-0201-3115> ;
        dc:description                 "OQUO module that defines the OQuaRE quality model for ontologies. OQuaRE adapts the SQuaRE (ISO/IEC 25000) standard for software product quality to ontologies, defining a set of quality characteristics, namely structural, functional adequacy, reliability, operability, maintainability, compatibility, transferability and quality in use, which are refined into subcharacteristics related through hasSubCharacteristic. The module also defines the OQuaRE five categories scale, an ordinal scale ranging from 1 (not acceptable) to 5 (exceeds the requirements) on which characteristics and subcharacteristics are measured. The module extends the OQUO core, and can in turn be extended by framework modules that define metrics associated with its characteristics and the conversions from their raw scales into the OQuaRE five categories scale."@en ;
        dc:publisher                   "Universidad de Murcia" ;
        dc:source                      <https://doi.org/10.3316/informit.265844843145749> ;
        dc:title                       "OQUO OQuaRE quality model"@en ;
        terms:created                  "2026-10-29"^^xsd:date ;
        terms:license                  <http://www.apache.org/licenses/LICENSE-2.0> ;
        vann:preferredNamespacePrefix  "oquo-oquare-qm" ;
        vann:preferredNamespaceUri     "https://purl.org/oquo-oquare-qm#" ;
        schema:codeRepository          <https://github.com/tecnomod-um/oquo> ;
        owl:versionIRI                 <https://purl.org/oquo-oquare-qm/v2.0.1> ;
        foaf:homepage                  <https://github.com/tecnomod-um/oquare> .

