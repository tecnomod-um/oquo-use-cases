<https://purl.org/oquo-core>
        a                              owl:Ontology ;
        dc:contributor                 <https://orcid.org/0000-0003-0487-308X> , <https://orcid.org/0009-0008-4226-2582> , <https://orcid.org/0000-0002-7558-2880> , <https://orcid.org/0000-0003-0201-3115> , <https://orcid.org/0000-0003-3641-7548> , <https://orcid.org/0000-0001-6233-6384> ;
        dc:creator                     <https://orcid.org/0000-0003-0201-3115> ;
        dc:description                 "OQUO (Ontology QUality Ontology) is a framework-agnostic ontology for describing quality models for ontologies and the results of ontology quality evaluations in a common, machine-readable format. The OQUO core provides the general vocabulary needed to define quality models, consisting of quality characteristics and subcharacteristics, the metrics that measure them and the scales on which they are measured, together with the conversions between raw metric scales and the scales of quality models, which can be defined as cardinal to ordinal, cardinal to nominal, ordinal to ordinal and cardinal to cardinal mappings. It also represents the results of quality evaluations, including the observations made on the evaluated entities, the measured values, the evaluation context and configuration, and the issues detected, classified by severity and by non conformity. Specific quality models (e.g. OQuaRE or FAIR) are defined in separate modules that extend the core, and the metrics, raw scales and issue types of concrete evaluation frameworks are described in further modules that extend those quality models, so that the results of independently developed tools can be represented, compared and aggregated within a single model. OQUO reuses existing ontologies such as the Quality Model Ontology (QMO), the Evaluation Ontology (EVAL), the Extensible Observation Ontology (OBOE), and the Information Problem Ontology (IPO)."@en ;
        dc:publisher                   "Universidad de Murcia" ;
        dc:title                       "OQUO core"@en ;
        terms:created                  "2023-04-21"^^xsd:date ;
        terms:license                  <http://www.apache.org/licenses/LICENSE-2.0> ;
        vann:preferredNamespacePrefix  "oquo" ;
        vann:preferredNamespaceUri     "https://purl.org/oquo#" ;
        owl:versionIRI                 <https://purl.org/oquo-core/v2.2.2> .

<https://purl.org/oquo-oquare#scalePointMapping-999136ed-3b05-4674-83a8-409d24108383>
        a                              owl:NamedIndividual , oquo:CardinalToOrdinalScalePointMapping ;
        rdfs:label                     "mapping (0.4..0.6] -> 3 (Minimally acceptable)" ;
        oquo:hasInputCardinalInterval  <https://purl.org/oquo-oquare#interval-e1269a19-c92d-467b-a253-8b6143e87d88> ;
        oquo:hasOutputScaleCategory    oquo-oquare-qm:OquareCategory3 .

