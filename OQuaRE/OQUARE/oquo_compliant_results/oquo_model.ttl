                                                   owl:onProperty     oquo:measuresCharacteristicNegatively
                                                 ]
                                                 [ a                  owl:Restriction ;
                                                   owl:allValuesFrom  [ a            owl:Class ;
                                                                        owl:unionOf  ( oquo-oquare-qm:AnalysabilityCharacteristic oquo-oquare-qm:AvailabilityCharacteristic oquo-oquare-qm:ChangeabilityCharacteristic oquo-oquare-qm:CohesionCharacteristic oquo-oquare-qm:KnowledgeReuseCharacteristic oquo-oquare-qm:LearnabilityCharacteristic )
                                                                      ] ;
                                                   owl:onProperty     oquo:measuresCharacteristicPositively
                                                 ]
                                               )
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicNegatively ;
                           owl:someValuesFrom  oquo-oquare-qm:RecoverabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:LearnabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-oquare#LackOfCohesionInMethodsMetricScale> ;
                           owl:onProperty  qm:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:CohesionCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:AvailabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:KnowledgeReuseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    qm:LowerBest ;
                                                                         owl:onProperty  qm:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:ChangeabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:AnalysabilityCharacteristic
                         ] ;
        obo:IAO_0000115  "Semantic and conceptual relatedness of classes. It can be used to measure the separation of responsibilities and independence of components of ontologies LCOMOnto=∑Lenght(path(|C(leaf)i|))/m , where Lenght(path|C(leaf)i|) is the length of the path from the leaf class i to Thing, and m is the total number of paths in the ontology "@en ;
        dc:source        <https://doi.org/10.3316/informit.265844843145749> ;
        rdf1:acronym     "LCOMOnto" .

