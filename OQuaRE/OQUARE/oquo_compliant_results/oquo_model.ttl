oquo:OrdinalToNominalScalePointMapping
        a                owl:Class ;
        rdfs:comment     "Represents the mapping of a category of an ordinal scale onto a category of a nominal scale." ;
        rdfs:label       "ordinal to nominal scale point mapping" ;
        rdfs:subClassOf  oquo:ScalePointMapping ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               qm:OrdinalScaleItem ;
                           owl:onProperty            oquo:hasInputScaleCategory ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               om-1:Measurement_scale_category ;
                           owl:onProperty            oquo:hasOutputScaleCategory ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        obo:IAO_0000112  "The five categories of an ordinal scale can be converted into the categories acceptable and not acceptable of a nominal scale, with categories 1 and 2 mapped onto not acceptable and categories 3, 4 and 5 mapped onto acceptable." ;
        obo:IAO_0000115  "A scale point mapping that converts a category of an input ordinal scale into a category of an output nominal scale. Each mapping has exactly one input ordinal scale category (hasInputScaleCategory) and one output scale category (hasOutputScaleCategory). An ordinal to nominal scale conversion contains one of these mappings for each category of the input scale, and several input categories may be converted into the same output category. The order of the input categories is not preserved in the output scale." .

