        rdfs:label                     "mapping [0.4..0.7) -> 4 (Acceptable)" ;
        oquo:hasInputCardinalInterval  <https://purl.org/oquo-oquare#interval-b55efcbe-cf94-4583-99c4-bbd694b92e40> ;
        oquo:hasOutputScaleCategory    oquo-oquare-qm:OquareCategory4 .

