<https://purl.org/oquo-oquare#NumberOfAncestorClassesMetric>
        a                owl:Class ;
        rdfs:comment     "Mean number of ancestor classes per leaf class." ;
        rdfs:label       "number of ancestor classes metric" ;
        rdfs:subClassOf  qm:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:KnowledgeReuseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    qm:LowerBest ;
                                                                         owl:onProperty  qm:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-oquare#NumberOfAncestorClassesMetricScale> ;
                           owl:onProperty  qm:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:KnowledgeReuseCharacteristic )
                                              ] ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        obo:IAO_0000115  "Mean number of ancestor classes per leaf class. It is the number of direct superclasses per leaf class NACOnto=∑|SupC(Leaf)i|/∑|C(leaf)i)| "@en ;
        dc:source        <https://doi.org/10.3316/informit.265844843145749> ;
        rdf1:acronym     "NACOnto" .

