oquo:CardinalToOrdinalScaleConversion
        a                owl:Class , oboe:Entity , eval:EvaluationSubject , ipo:Asset ;
        rdfs:comment     "Defines how to convert a cardinal scale into an ordinal scale." ;
        rdfs:label       "cardinal to ordinal scale conversion" ;
        rdfs:subClassOf  oquo:ScaleConversion ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasOutputScale ;
                           owl:someValuesFrom  om-1:Ordinal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasInputScale ;
                           owl:someValuesFrom  om-1:Cardinal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasScalePointMapping ;
                           owl:someValuesFrom  oquo:CardinalToOrdinalScalePointMapping
