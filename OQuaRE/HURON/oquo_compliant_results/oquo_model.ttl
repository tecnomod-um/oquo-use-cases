oquo:CardinalToCardinalScaleConversion
        a                oboe:Entity , eval:EvaluationSubject , owl:Class , ipo:Asset ;
        rdfs:comment     "Defines the conversion between cardinal scales." ;
        rdfs:label       "cardinal to cardinal scale conversion" ;
        rdfs:subClassOf  oquo:ScaleConversion ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasInputScale ;
