oquo-oquare-qm:ReliabilityCharacteristic
        a                owl:Class ;
        rdfs:label       "reliability characteristic" ;
        rdfs:subClassOf  qm:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:AvailabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:RecoverabilityCharacteristic
                         ] ;
        obo:IAO_0000115  "Capability of an ontology to maintain its level of performance under stated conditions for a given period of time."@en ;
        dc:source        <https://doi.org/10.3316/informit.265844843145749> .

