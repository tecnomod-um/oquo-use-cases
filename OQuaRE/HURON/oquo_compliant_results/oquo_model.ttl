<https://purl.org/oquo-huron#NamesPerPropertyMetric>
        a                owl:Class ;
        rdfs:comment     "Number of names per property in the ontology, considering object, datatype, and annotation properties." ;
        rdfs:label       "names per property metric" ;
        rdfs:subClassOf  qm:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    qm:HigherBest ;
                                                                         owl:onProperty  qm:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-huron#NamesPerPropertyMetricScale> ;
                           owl:onProperty  qm:hasScale
                         ] ;
        obo:IAO_0000115  "This metric accounts for the number of names associated with properties, which can also be provided by using different annotation properties used by the community to include names (rdfs:label, skos:prefLabel, foaf:name, etc.). This metric is calculated as the total number of names associated with ontology properties (including annotation, data, and object properties) divided by the total number of properties in the ontology. The range of the value of this metric is the set of real positive numbers."@en ;
        dc:source        <https://doi.org/10.1109/ACCESS.2023.3316512> ;
        rdf1:acronym     "NxP" .

