        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:ChangeabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:ReusabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:TestabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:AnalysabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:ModularityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:AnalysabilityCharacteristic oquo-oquare-qm:ChangeabilityCharacteristic oquo-oquare-qm:ModificationStabilityCharacteristic oquo-oquare-qm:ModularityCharacteristic oquo-oquare-qm:ReusabilityCharacteristic oquo-oquare-qm:TestabilityCharacteristic )
