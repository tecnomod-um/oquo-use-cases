<https://purl.org/oquo-huron#LexicallySuggestLogicallyDefineMetric>
        a                owl:Class ;
        rdfs:comment     "The degree in which LR classes are semantically linked to the classes exhibiting the corresponding lexical regularity." ;
        rdfs:label       "lexically suggest logically define metric" ;
        rdfs:subClassOf  qm:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    qm:HigherBest ;
                                                                         owl:onProperty  qm:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:StructuralAccuracyCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:TextAnalysisCharacteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-huron#LexicallySuggestLogicallyDefineMetricScale> ;
                           owl:onProperty  qm:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:StructuralAccuracyCharacteristic oquo-oquare-qm:TextAnalysisCharacteristic )
                                              ] ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        obo:IAO_0000115  "This metric is related to the design principle of the same name, which we interpret as follows: what is expressed in natural language for humans should be expressed as logical axioms for the machine. It is calculated as the ratio in which an LR class is semantically related to other classes exhibiting its lexical regularity. Here, two classes are semantically related if there exist a path of an arbitrary length between them through the axioms in the ontology (i.e. subclass of, equivalency, or domain/range property). For computational reasons, we limited the length of the path between classes up to 5 steps; thus, classes semantically related between them through longer paths will be considered as not semantically related. In this case, positive cases are classes exhibiting a lexical regularity and that are semantically linked with the corresponding LR class. Negative cases are classes exhibiting a lexical regularity and that are not semantically linked with the corresponding LR class. The value of the metric is calculated by dividing the positive cases by the total number of cases. This metric is calculated for each LR class. The final value of the metric for an ontology is calculated as the sum of all the positive cases divided by the sum of all the positive and negative cases obtained by each LR class in the ontology. The value is in the range [0, 1], the highest values representing the best values for the metric."@en ;
        dc:source        <https://doi.org/10.1109/ACCESS.2023.3316512> ;
        rdf1:acronym     "LSLD" .

