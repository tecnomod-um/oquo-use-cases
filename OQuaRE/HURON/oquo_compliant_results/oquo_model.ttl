<https://purl.org/oquo-huron#NamesPerObjectPropertyMetric>
        a                owl:Class ;
        rdfs:comment     "The total number of object property names over the total number of object properties." ;
        rdfs:label       "names per object property metric" ;
        rdfs:subClassOf  qm:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:EaseOfUseCharacteristic oquo-oquare-qm:EfficiencyInUseCharacteristic oquo-oquare-qm:IndexingAndLinkingCharacteristic oquo-oquare-qm:KnowledgeReuseCharacteristic oquo-oquare-qm:TextAnalysisCharacteristic )
                                              ] ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    qm:HigherBest ;
                                                                         owl:onProperty  qm:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:IndexingAndLinkingCharacteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-huron#NamesPerObjectPropertyMetricScale> ;
                           owl:onProperty  qm:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:TextAnalysisCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:EfficiencyInUseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:KnowledgeReuseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:EaseOfUseCharacteristic
                         ] ;
        obo:IAO_0000115  "This metric accounts for the number of names associated with object properties, and uses the list of annotation properties used by the community for names (rdfs:label, skos:prefLabel, foaf:name, etc.). Then, this metric is calculated as the number of names associated with ontology object properties divided by the total number of object properties in the ontology. The range of the value of this metric is the set of real positive numbers. Values lower than one mean that there are object properties without any name in the ontology. Contrariwise, a value greater than 1 indicates that there are object properties with multiple names; possibly caused by the inclusion of multilingual names or by some design decision."@en ;
        dc:source        <https://doi.org/10.1109/ACCESS.2023.3316512> ;
        rdf1:acronym     "NxOP" .

<https://purl.org/oquo-data/evaluation-baac8e97-d021-4df6-8db1-a348e29739ae>
        a                          eval:Evaluation , prov:Activity ;
