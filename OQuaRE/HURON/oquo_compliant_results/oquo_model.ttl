        a                       owl:Class ;
        rdfs:label              "data property with no synonyms issue" ;
        rdfs:subClassOf         <https://purl.org/oquo-huron#EntityWithNoSynonymsIssue> ;
        owl:equivalentClass     [ a                   owl:Class ;
                                  owl:intersectionOf  ( <https://purl.org/oquo-huron#EntityWithNoSynonymsIssue>
                                                        [ a                   owl:Restriction ;
                                                          owl:onProperty      ipo:hasHostAsset ;
                                                          owl:someValuesFrom  owl:DatatypeProperty
                                                        ]
                                                      )
                                ] ;
        skos:definition         "The data property does not have any synonym." ;
        oquo:hasRecommendation  "Each element in the ontology must be enriched with synonyms whenever possible. Synonyms are alternative names to the canonical one, which are widely accepted by the community and used in particular domains. This facilitates the understanding by human users from different backgrounds and improves the use of the ontology for NLP processes." .

