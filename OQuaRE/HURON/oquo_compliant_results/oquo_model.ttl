oquo:NominalToOrdinalScaleConversion
        a                owl:Class , eval:EvaluationSubject , ipo:Asset , oboe:Entity ;
        rdfs:comment     "Defines the conversion from a nominal scale to an ordinal scale." ;
        rdfs:label       "nominal to ordinal scale conversion" ;
        rdfs:subClassOf  oquo:ScaleConversion ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasOutputScale ;
                           owl:someValuesFrom  om-1:Ordinal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasInputScale ;
                           owl:someValuesFrom  om-1:Nominal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasScalePointMapping ;
