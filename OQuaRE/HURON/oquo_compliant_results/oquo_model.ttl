<https://purl.org/oquo-huron#NamesPerDataPropertyMetric>
        a                owl:Class ;
        rdfs:comment     "The total number of data property names over the total number of data properties." ;
        rdfs:label       "names per data property metric" ;
        rdfs:subClassOf  qm:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:EfficiencyInUseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    qm:HigherBest ;
                                                                         owl:onProperty  qm:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-huron#NamesPerDataPropertyMetricScale> ;
                           owl:onProperty  qm:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:IndexingAndLinkingCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:KnowledgeReuseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:EaseOfUseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:EaseOfUseCharacteristic oquo-oquare-qm:EfficiencyInUseCharacteristic oquo-oquare-qm:IndexingAndLinkingCharacteristic oquo-oquare-qm:KnowledgeReuseCharacteristic oquo-oquare-qm:TextAnalysisCharacteristic )
                                              ] ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:TextAnalysisCharacteristic
                         ] ;
        obo:IAO_0000115  "This metric accounts for the number of names associated with data type properties, and uses the list of annotation properties used by the community for names (rdfs:label, skos:prefLabel, foaf:name, etc.). Then, this metric is calculated as the number of names associated with ontology data type properties divided by the total number of data type properties in the ontology. The range of the value of this metric is the set of real positive numbers. Values lower than one mean that there are data type properties without any name in the ontology. Contrariwise, a value greater than 1 indicates that there are data type properties with multiple names; possibly caused by the inclusion of multilingual names or by some design decision."@en ;
        dc:source        <https://doi.org/10.1109/ACCESS.2023.3316512> ;
        rdf1:acronym     "NxDP" .

