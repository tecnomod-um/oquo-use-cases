<https://purl.org/oquo-huron#huron-software-agent>
        a                      owl:NamedIndividual , prov:SoftwareAgent ;
        rdfs:comment           "Software that implements the HURON framework and computes its metrics."@en ;
        rdfs:label             "huron software agent" ;
        obo:IAO_0000115        "The software implementation of HURON (HUman Readability ONtologies), a framework for assessing the human readability of ontologies. Given an ontology, it computes the 34 HURON metrics, which measure the names, descriptions and synonyms of its classes and properties, as well as the lexical regularities and systematic naming of class labels, and reports the issues detected. It acts as the agent of the evaluations whose results are described with this module."@en ;
        dc:source              <https://doi.org/10.1109/ACCESS.2023.3316512> ;
        schema:codeRepository  <https://github.com/tecnomod-um/huron> ;
        foaf:homepage          <https://semantics.inf.um.es/huron/> .

