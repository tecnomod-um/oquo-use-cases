<https://purl.org/oquo-huron>
        a                              owl:Ontology ;
        rdfs:seeAlso                   <http://semantics.inf.um.es/huron/> , <https://github.com/tecnomod-um/huron> ;
        dc:contributor                 <https://orcid.org/0000-0002-7558-2880> , <https://orcid.org/0000-0003-0201-3115> , <https://orcid.org/0000-0003-1857-1744> ;
        dc:creator                     <https://orcid.org/0000-0003-0201-3115> ;
        dc:description                 "OQUO module that integrates HURON (HUman Readability ONtologies), a framework for assessing the human readability of ontologies, with the OQuaRE quality model. The module defines the 34 metrics computed by HURON, which measure the names, descriptions and synonyms of classes and properties, as well as the lexical regularities and systematic naming of class labels, and associates them with the OQuaRE characteristics they measure. Each metric has its own raw scale, and the module defines the conversions of these raw scales into the OQuaRE five categories scale by means of cardinal to ordinal scale conversions. The module also defines the 17 types of issues that HURON can report, such as entities without names, descriptions or synonyms, together with recommendations to solve them."@en ;
        dc:publisher                   "Universidad de Murcia" ;
        dc:title                       "OQUO HURON module"@en ;
        terms:created                  "2025-02-10"^^xsd:date ;
        terms:license                  <https://www.gnu.org/licenses/gpl-3.0.html> ;
        vann:preferredNamespacePrefix  "oquo-huron" ;
        vann:preferredNamespaceUri     "https://purl.org/oquo-huron#" ;
        schema:codeRepository          "https://github.com/tecnomod-um/huron" ;
        owl:versionIRI                 <https://purl.org/oquo-huron/v2.0.1> ;
        foaf:homepage                  "http://semantics.inf.um.es/huron/" .

