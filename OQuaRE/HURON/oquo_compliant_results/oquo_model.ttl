                         ] ;
        obo:IAO_0000115  "This metric accounts for the number of synonyms associated with annotation properties, which can also be provided by using different annotation properties used by the community to include synonyms (oboInOwl:hasExactSynonym, skos:altLabel, iao:0000118, etc.). This metric is calculated as the number of synonyms associated with annotation properties divided by the total number of annotation properties in the ontology. The range of the value of this metric is the set of real positive numbers."@en ;
        dc:source        <https://doi.org/10.1109/ACCESS.2023.3316512> ;
        rdf1:acronym     "SxAP" .

