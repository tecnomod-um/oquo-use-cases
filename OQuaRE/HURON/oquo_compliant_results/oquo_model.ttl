        a                owl:Class ;
        rdfs:label       "flexibility in use characteristic" ;
        rdfs:subClassOf  qm:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:ContextConformityInUseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:ContextExtendibilityInUseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:ContextConformityInUseCharacteristic oquo-oquare-qm:ContextExtendibilityInUseCharacteristic )
                                              ] ;
                           owl:onProperty     qm:hasSubCharacteristic
                         ] ;
