om-1:Ordered_measurement_scale_category
        a                eval:EvaluationSubject , owl:Class , oboe:Entity , ipo:Asset ;
        rdfs:label       "ordered measurement scale category"@en ;
        rdfs:subClassOf  om-1:Measurement_scale_category ;
        ipo:hostAssetOf  <https://purl.org/oquo-data/issue-8b1290df-ef45-407d-9918-6e095bba3f26> , <https://purl.org/oquo-data/issue-a80d5edd-b303-403e-a448-6faccd8683fe> .

oquo-oquare-qm:UsabilityInUseCharacteristic
        a                owl:Class ;
        rdfs:label       "usability in use characteristic" ;
        rdfs:subClassOf  qm:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:EffectivenessInUseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:EfficiencyInUseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:SatisfactionInUseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:EffectivenessInUseCharacteristic oquo-oquare-qm:EfficiencyInUseCharacteristic oquo-oquare-qm:SatisfactionInUseCharacteristic )
                                              ] ;
                           owl:onProperty     qm:hasSubCharacteristic
                         ] ;
        dc:source        <https://doi.org/10.3316/informit.265844843145749> .

