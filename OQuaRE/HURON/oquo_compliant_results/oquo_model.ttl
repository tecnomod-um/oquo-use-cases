oquo:CardinalToNominalScaleConversion
        a                ipo:Asset , eval:EvaluationSubject , owl:Class , oboe:Entity ;
        rdfs:comment     "Defines how to convert a cardinal scale into a nominal scale." ;
        rdfs:label       "cardinal to nominal scale conversion" ;
        rdfs:subClassOf  oquo:ScaleConversion ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasOutputScale ;
                           owl:someValuesFrom  om-1:Nominal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasInputScale ;
                           owl:someValuesFrom  om-1:Cardinal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasScalePointMapping ;
                           owl:someValuesFrom  oquo:CardinalToNominalScalePointMapping
                         ] ;
