<https://purl.org/oquo-huron#LexicalRegularitiesPerClassMetric>
        a                owl:Class ;
        rdfs:comment     "The number of lexical regularities appearing in the ontology over the number of classes." ;
        rdfs:label       "lexical regularities per class metric" ;
        rdfs:subClassOf  qm:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:StructuralAccuracyCharacteristic oquo-oquare-qm:TextAnalysisCharacteristic )
                                              ] ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:StructuralAccuracyCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-oquare-qm:TextAnalysisCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    qm:HigherBest ;
                                                                         owl:onProperty  qm:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-huron#LexicalRegularitiesPerClassMetricScale> ;
                           owl:onProperty  qm:hasScale
                         ] ;
        obo:IAO_0000115  "This metric measures the proportion between the total number of lexical regularities appearing in the ontology and the total number of classes. This metric can measure whether the ontology is using genus-differentia naming style."@en ;
        dc:source        <https://doi.org/10.1109/ACCESS.2023.3316512> ;
        rdf1:acronym     "LRsxC" .

