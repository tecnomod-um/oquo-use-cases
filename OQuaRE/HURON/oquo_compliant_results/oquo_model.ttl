oquo-oquare-qm:TransferabilityCharacteristic
        a                owl:Class ;
        rdfs:label       "transferability characteristic" ;
        rdfs:subClassOf  qm:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:AdaptabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:PortabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:AdaptabilityCharacteristic oquo-oquare-qm:PortabilityCharacteristic )
                                              ] ;
                           owl:onProperty     qm:hasSubCharacteristic
                         ] ;
        obo:IAO_0000115  "The degree to which the software product can be transferred from one environment to another."@en ;
