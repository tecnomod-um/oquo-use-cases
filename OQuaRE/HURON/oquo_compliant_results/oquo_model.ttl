oquo-oquare-qm:SatisfactionInUseCharacteristic
        a                owl:Class ;
        rdfs:label       "satisfaction in use characteristic" ;
        rdfs:subClassOf  qm:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:CognitiveSatisfactionCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:EmotionalSatisfactionCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:PhysicalSatisfactionCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:CognitiveSatisfactionCharacteristic oquo-oquare-qm:EmotionalSatisfactionCharacteristic oquo-oquare-qm:PhysicalSatisfactionCharacteristic )
                                              ] ;
                           owl:onProperty     qm:hasSubCharacteristic
                         ] ;
        obo:IAO_0000115  "The degree to which users are satisfied in a especified context of use."@en ;
        dc:source        <https://doi.org/10.3316/informit.265844843145749> .

