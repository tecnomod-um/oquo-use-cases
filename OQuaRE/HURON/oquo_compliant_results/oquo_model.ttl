oquo-oquare-qm:StructuralCharacteristic
        a                owl:Class ;
        rdfs:label       "structural characteristic" ;
        rdfs:subClassOf  qm:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:StructuralAccuracyCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:CohesionCharacteristic oquo-oquare-qm:ConsistencyCharacteristic oquo-oquare-qm:CyclesCharacteristic oquo-oquare-qm:DomainCoverageCharacteristic oquo-oquare-qm:FormalRelationSupportCharacteristic oquo-oquare-qm:FormalisationCharacteristic oquo-oquare-qm:RedundancyCharacteristic oquo-oquare-qm:StructuralAccuracyCharacteristic oquo-oquare-qm:TanglednessCharacteristic )
                                              ] ;
                           owl:onProperty     qm:hasSubCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:TanglednessCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:RedundancyCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:DomainCoverageCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:FormalisationCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:CyclesCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:CohesionCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:ConsistencyCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:FormalRelationSupportCharacteristic
                         ] ;
