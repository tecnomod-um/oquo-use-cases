oquo-oquare-qm:OperabilityCharacteristic
        a                owl:Class ;
        rdfs:label       "operability characteristic" ;
        rdfs:subClassOf  qm:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:LearnabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:EaseOfUseCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:AppropriatenessRecognisabilityCharacteristic oquo-oquare-qm:EaseOfUseCharacteristic oquo-oquare-qm:HelpfulnessCharacteristic oquo-oquare-qm:LearnabilityCharacteristic )
                                              ] ;
                           owl:onProperty     qm:hasSubCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:HelpfulnessCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:AppropriatenessRecognisabilityCharacteristic
                         ] ;
        obo:IAO_0000115  "Effort needed for use, and on the individual assessment of such use, by a stated or implied set of users."@en ;
        dc:source        <https://doi.org/10.3316/informit.265844843145749> .

