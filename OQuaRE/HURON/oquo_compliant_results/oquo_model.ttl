oquo-oquare-qm:CompatibilityCharacteristic
        a                owl:Class ;
        rdfs:label       "compatibility characteristic" ;
        rdfs:subClassOf  qm:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:InteroperabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      qm:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-oquare-qm:ReplaceabilityCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-oquare-qm:InteroperabilityCharacteristic oquo-oquare-qm:ReplaceabilityCharacteristic )
                                              ] ;
                           owl:onProperty     qm:hasSubCharacteristic
                         ] ;
        obo:IAO_0000115  "The ability of two or more software components to exchange information and/or to perform their required functions while sharing the same hardware or software environment."@en ;
        dc:source        <https://doi.org/10.3316/informit.265844843145749> .

