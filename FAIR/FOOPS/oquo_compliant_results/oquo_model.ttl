<https://purl.org/oquo-foops#DetailedMetadataMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology declares a set of detailed metadata fields."@en ;
        rdfs:label       "detailed metadata metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/OM3> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#DetailedMetadataMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology metadata include a set of detailed fields: DOI, publisher, logo, status, source and issued date. Previous version, backward compatibility and modification date are also inspected but their absence is not penalised. Each mandatory field is checked by a separate test. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle R1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/OM3"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "OM3" .

<https://purl.org/oquo-data/observation-d6af02c0-f139-47ca-8a15-7caecd15bfda>
        a       <http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#Observation> ;
        <http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#hasMeasurement>
                <https://purl.org/oquo-data/metric-64dc6f18-7f91-4436-b10a-10cc9a5affd3> ;
        <http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#ofEntity>
                <https://purl.org/oquo-core> ;
        <http://www.w3.org/2006/time#hasTime>
                <https://purl.org/oquo-data/instant-718fd5e6-783c-4620-bda2-3f32ff79be9e> .

<https://purl.org/oquo-foops#OntologyLevelFOOPSIssue>
        a                owl:Class ;
        rdfs:label       "ontology level FOOPS! issue"@en ;
        rdfs:subClassOf  <https://purl.org/oquo-foops#FOOPSIssue> ;
        skos:definition  "FOOPS! issue affecting the ontology as a whole, whose host asset is the evaluated ontology. One issue of this kind is reported for each failed FOOPS! check."@en .

<https://purl.org/oquo-data/issue-bb68fa07-246e-4e17-bbe0-d8cc48ceb396>
        a             <https://purl.org/oquo-foops#InconsistentOntologyIDIssue> ;
        rdfs:comment  "Ontology URI is different from ontology ID. Your ontologyURI (e.g., its w3id) should be the same as the one used within the ontology itself. Ontology URI: https://purl.org/oquo-core. Provided URI: https://purl.org/oquo-core/v2.2.2" ;
        <http://purl.org/ipo/core#hasHostAsset>
                <https://purl.org/oquo-core> ;
        <http://purl.org/ipo/core#indicatedBy>
                <https://purl.org/oquo-data/observation-60b788ab-4247-411e-9bd2-48f8af159204> .

xsd:date  a     rdfs:Datatype .

<https://purl.org/oquo-foops#MissingDetailedMetadataIssue>
        a                       owl:Class ;
        rdfs:label              "missing detailed metadata issue"@en ;
        rdfs:seeAlso            <https://w3id.org/foops/test/OM3> ;
        rdfs:subClassOf         <https://purl.org/oquo-foops#OntologyLevelFOOPSIssue> ;
        skos:definition         "The ontology metadata lack some of the detailed metadata fields (DOI, publisher, logo, status, source or issued date)."@en ;
        oquo:hasRecommendation  "Add the missing detailed metadata to the ontology header, e.g. a DOI (bibo:doi), dcterms:publisher, foaf:logo, a status (bibo:status), dcterms:source and dcterms:issued, and consider declaring the previous version, the backward compatibility and the modification date."@en .

<https://purl.org/oquo-foops#ContentNegotiationMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology can be retrieved both as HTML and in a recognised RDF serialisation."@en ;
        rdfs:label       "content negotiation metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/CN1> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#ContentNegotiationMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:A1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:A1Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology is served through content negotiation both as a human-readable HTML representation and in at least one recognised RDF serialisation, such as RDF/XML or Turtle. It runs two tests, one for the HTML representation and one for the RDF serialisations, and fails if any of them cannot be retrieved. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle A1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/CN1"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "CN1" .

