om-1:Measurement_scale
        a                       owl:Class ;
        rdfs:comment            "Measurement scales are concepts used for the expression of quantities. Four types of measurement scales are: nominal scales, ordinal scales, interval scales and ratio scales. The latter two scales are also called cardinal scales. An example of a scale is the Celsius scale, a temperature scale."@en ;
        rdfs:label              "measurement scale"@en ;
        om-1:alternative_label  "scale"@en .

QualityModel:hasLabel
        a             owl:DatatypeProperty ;
        rdfs:comment  "Denotes a label of a nominal scale or of an ordinal scale item." ;
        rdfs:domain   [ a            owl:Class ;
                        owl:unionOf  ( QualityModel:OrdinalScaleItem om-1:Nominal_scale )
                      ] ;
        rdfs:label    "hasLabel" ;
        rdfs:range    xsd:string .

owl:Thing  a              owl:Class ;
        rdfs:comment      "The class of OWL individuals." ;
        rdfs:isDefinedBy  owl: ;
        rdfs:label        "Thing" .

oquo:ScaleConversion  a  owl:Class ;
        rdfs:comment     "Defines how to convert one scale into another." ;
        rdfs:label       "scale conversion" ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasInputScale ;
                           owl:someValuesFrom  om-1:Measurement_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasOutputScale ;
                           owl:someValuesFrom  om-1:Measurement_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasScalePointMapping ;
                           owl:someValuesFrom  oquo:ScalePointMapping
                         ] .

oquo:EvaluationConfigurationData
        a                 owl:Class ;
        rdfs:comment      "Class to specify the configuration used for an evaluation. This configuration is stored as plain text through 'hasLiteralValue'. The ontology user should decide the format to store its configuration data (xml, json, etc...)." ;
        rdfs:label        "evaluation configuration data" ;
        rdfs:subClassOf   <http://purl.org/net/EvaluationResult#EvaluationData> ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      <https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> ;
                            owl:someValuesFrom  xsd:string
                          ] ;
        owl:disjointWith  oquo:EvaluationInputData .

