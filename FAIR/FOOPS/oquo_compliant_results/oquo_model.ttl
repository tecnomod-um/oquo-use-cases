oquo-fair-qm:AccessibleCharacteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata can be retrieved once found."@en ;
        rdfs:label       "FAIR accessible characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:A1Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-fair-qm:A1Characteristic oquo-fair-qm:A2Characteristic )
                                              ] ;
                           owl:onProperty     QualityModel:hasSubCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:A2Characteristic
                         ] ;
        obo:IAO_0000115  "Degree to which, once the resource has been found, users and software agents know how it and its metadata can be retrieved, possibly including authentication and authorisation. Accessibility does not require the resource to be open, but requires that the conditions and mechanisms of access are clear and standardised, and that metadata remain available over time. It is assessed through the subcharacteristics A1 (refined by A1.1 and A1.2) and A2."@en ;
        obo:IAO_0000119  "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en , "GO FAIR Foundation, https://www.gofair.foundation/fair-principles"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "A" .

