oquo:CardinalToNominalScalePointMapping
        a                owl:Class ;
        rdfs:comment     "Represents the mapping between a cardinal value in one scale and a nominal value in another scale." ;
        rdfs:label       "cardinal to nominal scale point mapping" ;
        rdfs:subClassOf  oquo:ScalePointMapping ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               oquo:Interval ;
                           owl:onProperty            oquo:hasInputCardinalInterval ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               om-1:Measurement_scale_category ;
                           owl:onProperty            oquo:hasOutputScaleCategory ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

