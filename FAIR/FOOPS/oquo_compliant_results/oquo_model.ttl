om-1:Unit_of_measure  a         owl:Class ;
        rdfs:comment            "A unit of measure is a definite magnitude of a quantity, defined and adopted by convention and/or by law. It is used as a standard for measurement of the same quantity, where any other value of the quantity can be expressed as a simple multiple of the unit of measure. For example, length is a quantity; the metre is a unit of length that represents a definite predetermined length. When we say 10 metre (or 10 m), we actually mean 10 times the definite predetermined length called \"metre\"."@en ;
        rdfs:label              "unit of measure"@en ;
        om-1:alternative_label  "unit"@en , "unit of measurement"@en .

oquo-fair-qm:A2Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which metadata remain accessible when the resource is no longer available."@en ;
        rdfs:label       "FAIR A2 metadata accessible when data are no longer available characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the metadata of the resource remain accessible even after the resource itself is no longer available, for instance because it has been deprecated, withdrawn or moved. Persistent metadata allow users to know that the resource existed, what it contained and by what it may have been superseded. For ontologies, this involves keeping available the metadata of previous versions and of obsolete entities (e.g. through owl:deprecated and replacement annotations)."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/a2"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "A2" .

