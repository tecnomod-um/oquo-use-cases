oquo-fair-qm:InteroperableCharacteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource can be integrated with other data, applications and workflows."@en ;
        rdfs:label       "FAIR interoperable characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:I3Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-fair-qm:I1Characteristic oquo-fair-qm:I2Characteristic oquo-fair-qm:I3Characteristic )
                                              ] ;
                           owl:onProperty     QualityModel:hasSubCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:I1Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:I2Characteristic
                         ] ;
        obo:IAO_0000115  "Degree to which the resource can be integrated with other data and can interoperate with applications or workflows for analysis, storage and processing. Interoperability requires that the resource and its metadata are represented in formal, shared languages, use vocabularies that are themselves FAIR, and contain qualified references to other resources. It is assessed through the subcharacteristics I1 to I3."@en ;
        obo:IAO_0000119  "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en , "GO FAIR Foundation, https://www.gofair.foundation/fair-principles"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "I" .

