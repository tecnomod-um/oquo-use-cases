<http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#Characteristic>
        a             owl:Class ;
        rdfs:comment  "A characteristic represents a property of an entity that can be measured (e.g., height, length, or color).  A characteristic of an entity is observed through a measurement, which further asserts a value of the characteristic for the entity. A characteristic type (e.g., \"height\") can be associated with many different entities, whereas an individual characteristic (a particular occurrence of the \"height\" characteristic) is associated to exactly one entity." ;
        rdfs:label    "Characteristic"@en .

obo:IAO_0000119  a        owl:AnnotationProperty ;
        rdfs:isDefinedBy  obo:iao.owl ;
        rdfs:label        "definition source"@en ;
        obo:IAO_0000111   "definition source"@en ;
        obo:IAO_0000114   obo:IAO_0000122 ;
        obo:IAO_0000115   "Formal citation, e.g. identifier in external database to indicate / attribute source(s) for the definition. Free text indicate / attribute source(s) for the definition. EXAMPLE: Author Name, URI, MeSH Term C04, PUBMED ID, Wiki uri on 31.01.2007"@en ;
        obo:IAO_0000117   "PERSON:Daniel Schober"@en ;
        obo:IAO_0000119   "Discussion on obo-discuss mailing-list, see http://bit.ly/hgm99w"@en , "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en .

prov:n  a                 owl:AnnotationProperty ;
        rdfs:comment      "A reference to the principal section of the PROV-DM document that describes this concept."@en ;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#> .

<https://purl.org/oquo-foops#OntologyURIResolvableMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology URI declared in the document resolves to RDF content."@en ;
        rdfs:label       "ontology URI resolvable metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/URI1> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:F1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#OntologyURIResolvableMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F1Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology URI declared within the ontology document, which may differ from the URL given as input to FOOPS!, is resolvable and returns content in a recognised RDF serialisation. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle F1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/URI1"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "URI1" .

<https://purl.org/oquo-foops#LicenseNotResolvableIssue>
        a                       owl:Class ;
        rdfs:label              "license not resolvable issue"@en ;
        rdfs:seeAlso            <https://w3id.org/foops/test/OM4.2> ;
        rdfs:subClassOf         <https://purl.org/oquo-foops#OntologyLevelFOOPSIssue> ;
        skos:definition         "The license declared in the ontology metadata cannot be resolved."@en ;
        oquo:hasRecommendation  "Identify the license with a resolvable URL that leads to the license document, such as the IRI of a Creative Commons license, instead of a literal or a non-resolvable identifier."@en .

