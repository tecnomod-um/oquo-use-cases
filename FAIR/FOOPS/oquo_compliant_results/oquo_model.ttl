<https://purl.org/oquo-foops#VocabularyReuseMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology imports or reuses vocabularies other than RDF, RDFS and OWL."@en ;
        rdfs:label       "vocabulary reuse metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/VOC2> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:I2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:I2Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#VocabularyReuseMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology imports or extends, in its classes or properties, at least one well-established vocabulary besides RDF, RDFS and OWL. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle I2."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/VOC2"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "VOC2" .

