<https://purl.org/oquo-foops#PrefixInCommunityRegistryMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the prefix of the ontology is found in a community registry and resolves to the ontology URI."@en ;
        rdfs:label       "prefix in community registry metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/FIND2> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#PrefixInCommunityRegistryMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:F4Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F4Characteristic
                         ] ;
        obo:IAO_0000115  "This metric checks whether the prefix declared in the ontology metadata is registered in a community prefix registry and whether the registered namespace corresponds to the ontology URI, so that the ontology can be discovered from its prefix. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle F4."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/FIND2"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "FIND2" .

<https://purl.org/oquo-foops#LicenseAvailableMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology declares a license or rights statement."@en ;
        rdfs:label       "license available metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/OM4.1> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#LicenseAvailableMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1_1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1_1Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology metadata include a clearly defined license or rights statement that informs users about the conditions under which the ontology can be used and shared. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle R1.1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/OM4.1"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "OM4.1" .

