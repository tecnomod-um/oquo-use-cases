[ a                      owl:Axiom ;
  rdfs:isDefinedBy       "https://www.scribbr.com/statistics/ratio-data/" ;
  owl:annotatedProperty  rdfs:comment ;
  owl:annotatedSource    om-1:Ratio_scale ;
  owl:annotatedTarget    "A ratio scale is a quantitative scale where there is a true zero and equal intervals between neighboring points. Unlike on an interval scale, a zero on a ratio scale means there is a total absence of the variable you are measuring."
] .

