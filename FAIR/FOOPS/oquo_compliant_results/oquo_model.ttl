<https://purl.org/oquo-foops#ContentNegotiationMetricScaleToPercentageScaleMapping>
        a                              owl:NamedIndividual , oquo:CardinalToCardinalScalePointMapping ;
        rdfs:label                     "mapping [0.0..1.0] -> 100 * x + 0"@en ;
        oquo:hasInputCardinalInterval  <https://purl.org/oquo-foops#ClosedUnitInterval> ;
