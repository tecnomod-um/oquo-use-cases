<https://purl.org/oquo-fair-qm>
        a                              owl:Ontology ;
        obo:IAO_0000116                "The definitions of the characteristics are adapted from the FAIR principles published by the GO FAIR Foundation (CC BY 4.0) and Wilkinson et al. (2016), rephrased as degrees of compliance of an evaluated resource and illustrated for the case of ontologies."@en ;
        dc:contributor                 <https://orcid.org/0000-0003-0201-3115> ;
        dc:creator                     <https://orcid.org/0000-0003-0201-3115> ;
        dc:description                 "Quality model for OQUO based on the FAIR Guiding Principles. The four FAIR principles (Findable, Accessible, Interoperable, Reusable) are modelled as quality characteristics and their sub-principles (F1-F4, A1, A1.1, A1.2, A2, I1-I3, R1, R1.1-R1.3) as subcharacteristics, related through hasSubCharacteristic. Characteristics and subcharacteristics are measured on a percentage scale (0-100) of degree of compliance."@en ;
        dc:publisher                   "Universidad de Murcia" ;
        dc:source                      <https://doi.org/10.1038/sdata.2016.18> ;
        dc:title                       "OQUO FAIR quality model"@en ;
        terms:created                  "2026-10-29"^^xsd:date ;
        terms:license                  <http://www.apache.org/licenses/LICENSE-2.0> ;
        vann:preferredNamespacePrefix  "oquo-fair-qm" ;
        vann:preferredNamespaceUri     "https://purl.org/oquo-fair-qm#" ;
        schema:codeRepository          <https://github.com/tecnomod-um/oquo> ;
        owl:versionIRI                 <https://purl.org/oquo-fair-qm/v1.0.1> ;
        foaf:homepage                  <https://www.gofair.foundation/fair-principles> .

<https://purl.org/oquo-foops#OntologyNotInMetadataRegistryIssue>
        a                       owl:Class ;
        rdfs:label              "ontology not in metadata registry issue"@en ;
        rdfs:seeAlso            <https://w3id.org/foops/test/FIND3> ;
        rdfs:subClassOf         <https://purl.org/oquo-foops#OntologyLevelFOOPSIssue> ;
        skos:definition         "The ontology is not registered in a public metadata registry."@en ;
        oquo:hasRecommendation  "Register the ontology in a public ontology registry or repository, such as Linked Open Vocabularies, BioPortal, the OBO Foundry or OLS, so that it can be searched and found."@en .

<http://purl.org/ipo/core#Issue>
        a                 owl:Class ;
        rdfs:comment      "A problem or issue to be resolved. For example, something that is not operating normally or a hindrance to performing some task.\nA Issue can be cause and/or caused, directly or indirectly, by another Issue, the same that the Issue A can depend on the Issue B, needing that the Issue B be solved before solving Issue A.\nThe Issue can have a set of Actions (Procedures) that will fix it and also a Issue can be indicated by several Symptoms, where a set of Symptoms can identify a Issue."@en ;
        rdfs:isDefinedBy  <http://purl.org/ipo/core> ;
        rdfs:label        "Issue"@en ;
        rdfs:subClassOf   <http://purl.org/ipo/core#IssueEntity> ;
        rdfs:subClassOf   [ a                   owl:Restriction ;
                            owl:onProperty      <http://purl.org/ipo/core#indicatedBy> ;
                            owl:someValuesFrom  <http://purl.org/ipo/core#Symptom>
                          ] ;
        owl:disjointWith  <http://purl.org/ipo/core#Symptom> .

<https://purl.org/oquo-foops#OntologyInMetadataRegistryMetricScale>
        a                               owl:NamedIndividual , om-1:Ratio_scale , oquo:RawScale ;
        rdfs:label                      "ontology in metadata registry metric scale"@en ;
        obo:IAO_0000115                 "Raw scale of the ontology in metadata registry metric: the ratio between the tests passed and the tests run by the FOOPS! check FIND3, ranging from 0 (no test passed) to 1 (all tests passed)."@en ;
        QualityModel:hasLowerBoundary   "0"^^xsd:decimal ;
        QualityModel:hasRankigFunction  QualityModel:HigherBest ;
        QualityModel:hasUpperBoundary   "1"^^xsd:decimal .

om-1:Nominal_scale  a    owl:Class ;
        rdfs:label       "nominal scale"@en ;
        rdfs:subClassOf  om-1:Measurement_scale ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  om-1:Measurement_scale_category ;
                           owl:onProperty     om-1:element
                         ] .

<https://purl.org/oquo-foops#MissingRecommendedMetadataIssue>
        a                       owl:Class ;
        rdfs:label              "missing recommended metadata issue"@en ;
        rdfs:seeAlso            <https://w3id.org/foops/test/OM2> ;
        rdfs:subClassOf         <https://purl.org/oquo-foops#OntologyLevelFOOPSIssue> ;
        skos:definition         "The ontology metadata lack some of the recommended metadata fields (namespace prefix, version information, creation date or citation)."@en ;
        oquo:hasRecommendation  "Add the missing recommended metadata to the ontology header, e.g. vann:preferredNamespacePrefix, owl:versionInfo, dcterms:created and dcterms:bibliographicCitation, and consider adding the contributors (dcterms:contributor)."@en .

oquo:CardinalToNominalScaleConversion
