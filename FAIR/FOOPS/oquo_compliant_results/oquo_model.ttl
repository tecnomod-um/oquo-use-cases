<https://purl.org/oquo-foops#PersistentURLMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology URI is a persistent URL."@en ;
        rdfs:label       "persistent URL metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/PURL1> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:F1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#PersistentURLMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F1Characteristic
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology is identified by a persistent URL, such as those provided by w3id.org, purl.org or a DOI, which guarantees reliable and long-term access. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle F1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/PURL1"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "PURL1" .

