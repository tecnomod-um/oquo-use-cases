<https://purl.org/oquo-foops#HTMLDocumentationMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology has accessible HTML documentation."@en ;
        rdfs:label       "HTML documentation metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/DOC1> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#HTMLDocumentationMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "This metric checks whether an accessible, online HTML page documenting the ontology exists, so that users can understand its structure and content before reusing it. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle R1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/DOC1"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "DOC1" .

om-1:Ordinal_scale  a    owl:Class ;
        rdfs:label       "ordinal scale"@en ;
        rdfs:subClassOf  om-1:Measurement_scale ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  om-1:Ordered_measurement_scale_category ;
                           owl:onProperty     om-1:element
                         ] .

oquo-fair-qm:PercentageScale
        a                               owl:NamedIndividual , om-1:Ratio_scale ;
        rdfs:comment                    "Percentage scale (0-100) of degree of compliance with the FAIR principles."@en ;
        rdfs:label                      "FAIR percentage scale"@en ;
        obo:IAO_0000112                 "A value of 75 for the FAIR findable characteristic means that the evaluated resource fulfils 75% of what the findability principle requires."@en ;
        obo:IAO_0000115                 "Ratio scale used by the FAIR quality model to express the degree of compliance of an evaluated resource with a FAIR principle or sub-principle, as a percentage ranging from 0 (no compliance at all) to 100 (full compliance). Being a ratio scale, 0 denotes the total absence of compliance and values can be compared proportionally. Higher values are better. The raw values of the metrics of a framework integrated with this quality model must be converted to this scale before being aggregated into subcharacteristics and characteristics."@en ;
        QualityModel:hasLowerBoundary   "0"^^xsd:decimal ;
        QualityModel:hasRankigFunction  QualityModel:HigherBest ;
        QualityModel:hasUpperBoundary   "100"^^xsd:decimal .

