oquo-fair-qm:A1Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata are retrievable by their identifier through a standardised protocol."@en ;
        rdfs:label       "FAIR A1 retrievable by identifier through standardised protocol characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-fair-qm:A1_1Characteristic oquo-fair-qm:A1_2Characteristic )
                                              ] ;
                           owl:onProperty     QualityModel:hasSubCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:A1_2Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:A1_1Characteristic
                         ] ;
        obo:IAO_0000115  "Degree to which the resource and its metadata can be obtained from their identifier by means of a standardised communication protocol, without requiring specialised or proprietary tools. For an ontology, this usually means that its IRI and its entity IRIs are dereferenceable over HTTP(S), ideally supporting content negotiation to return machine-readable serialisations (e.g. RDF/XML or Turtle) or human-readable documentation. It is refined by the subcharacteristics A1.1 and A1.2."@en ;
        obo:IAO_0000119  "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en , "GO FAIR Foundation, https://www.gofair.foundation/a1"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
