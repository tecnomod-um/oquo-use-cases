<https://purl.org/oquo-foops>
        a                              owl:Ontology ;
        rdfs:seeAlso                   <https://w3id.org/foops/> , <https://github.com/oeg-upm/fair_ontologies> ;
        obo:IAO_0000116                "The definitions of the metrics are adapted from the FOOPS! metric descriptions (https://w3id.org/foops/catalog, CC BY 4.0). Each metric is linked through rdfs:seeAlso to the corresponding FOOPS! metric, and each issue type to the FOOPS! test that reports it. The IRI of the test is the id returned by FOOPS! for each check in its results, and the IRI of the metric it implements follows the same pattern, replacing /test/ with /metric/ (e.g. https://w3id.org/foops/test/PURL1 and https://w3id.org/foops/metric/PURL1)."@en ;
        dc:contributor                 <https://orcid.org/0000-0003-0201-3115> ;
        dc:creator                     <https://orcid.org/0000-0003-0201-3115> ;
        dc:description                 "OQUO extension module that describes the metrics of FOOPS! (Ontology Pitfall Scanner for FAIR), their raw scales and the conversions of these raw scales into the percentage scale of the OQUO FAIR quality model. Each FOOPS! check is represented as a metric linked to the FAIR subcharacteristic it assesses, whose raw value is the ratio between the passed and run tests of the check. The module also defines the types of issues of non conformity that FOOPS! can report: one ontology level issue per failed check, and one term level issue per term affected by the checks on term labels and definitions."@en ;
        dc:publisher                   "Universidad de Murcia" ;
        dc:source                      <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        dc:title                       "OQUO FOOPS! module"@en ;
        terms:created                  "2026-10-29"^^xsd:date ;
        terms:license                  <https://creativecommons.org/licenses/by/4.0/> ;
        vann:preferredNamespacePrefix  "oquo-foops" ;
        vann:preferredNamespaceUri     "https://purl.org/oquo-foops#" ;
        schema:codeRepository          <https://github.com/tecnomod-um/oquo-use-cases> ;
        owl:versionIRI                 <https://purl.org/oquo-foops/v1.0.0> .

