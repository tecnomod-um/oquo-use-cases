<https://purl.org/oquo-foops#VersionIRIResolvableMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the version IRI of the ontology resolves."@en ;
        rdfs:label       "version IRI resolvable metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/VER2> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F1Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#VersionIRIResolvableMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
