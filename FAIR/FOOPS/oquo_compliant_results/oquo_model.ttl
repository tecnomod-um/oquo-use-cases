        rdfs:domain   <http://purl.org/net/EvaluationResult#Evaluation> ;
        rdfs:label    "performedOn" ;
        rdfs:range    <http://www.w3.org/2006/time#Instant> .

<https://purl.org/oquo-foops#MissingDetailedProvenanceMetadataIssue>
        a                       owl:Class ;
        rdfs:label              "missing detailed provenance metadata issue"@en ;
        rdfs:seeAlso            <https://w3id.org/foops/test/OM5.2> ;
        rdfs:subClassOf         <https://purl.org/oquo-foops#OntologyLevelFOOPSIssue> ;
        skos:definition         "The ontology metadata lack some of the detailed provenance metadata (issued date or publisher)."@en ;
        oquo:hasRecommendation  "Add the issued date (e.g. dcterms:issued) and the publisher (e.g. dcterms:publisher) to the ontology header."@en .

