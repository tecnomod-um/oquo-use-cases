oquo-fair-qm:I3Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata include qualified references to other (meta)data."@en ;
        rdfs:label       "FAIR I3 qualified references characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the resource and its metadata contain qualified references to other data and metadata, that is, cross-references whose meaning is explicitly specified (i.e. which relation holds between the resources) rather than plain links. For ontologies, this includes the reuse of external entities and the mappings and alignments with other ontologies expressed through well-defined properties (e.g. owl:equivalentClass, skos:exactMatch, rdfs:seeAlso or database cross-references)."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/i3"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "I3" .

