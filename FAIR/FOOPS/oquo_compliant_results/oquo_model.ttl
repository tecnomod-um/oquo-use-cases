<https://purl.org/oquo-foops#DetailedMetadataMetricScale>
        a                               owl:NamedIndividual , om-1:Ratio_scale , oquo:RawScale ;
        rdfs:label                      "detailed metadata metric scale"@en ;
        obo:IAO_0000115                 "Raw scale of the detailed metadata metric: the ratio between the tests passed and the tests run by the FOOPS! check OM3, ranging from 0 (no test passed) to 1 (all tests passed)."@en ;
        QualityModel:hasLowerBoundary   "0"^^xsd:decimal ;
        QualityModel:hasRankigFunction  QualityModel:HigherBest ;
        QualityModel:hasUpperBoundary   "1"^^xsd:decimal .

<https://purl.org/oquo-foops#TermLabelsMetric>
        a                owl:Class ;
        rdfs:comment     "Proportion of ontology terms that have a human-readable label."@en ;
        rdfs:label       "term labels metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/VOC3> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#TermLabelsMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        obo:IAO_0000115  "This metric checks whether the terms of the ontology have human-readable labels. FOOPS! runs one test per term, so the value of the metric is the proportion of terms with a label. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle R1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/VOC3"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "VOC3" .

<http://purl.org/ipo/core#hasAsset>
        a                 owl:ObjectProperty ;
        rdfs:comment      "Indicates an Asset to IssueEntity, i.e., any \"thing\" which is related to IssueEntity."@en ;
        rdfs:isDefinedBy  <http://purl.org/ipo/core> ;
        rdfs:label        "hasAsset"@en .

<https://purl.org/oquo-foops#BasicProvenanceMetadataMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology declares basic provenance metadata (author and creation date)."@en ;
        rdfs:label       "basic provenance metadata metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/OM5.1> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1_2Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1_2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#BasicProvenanceMetadataMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology metadata include basic provenance information, namely the author and the creation date, which are mandatory; contributors and previous version are recommended but not required. Each mandatory field is checked by a separate test. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle R1.2."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/OM5.1"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "OM5.1" .

<https://purl.org/oquo-foops#MetadataNotAccessibleWithoutOntologyIssue>
        a                       owl:Class ;
        rdfs:label              "metadata not accessible without ontology issue"@en ;
        rdfs:seeAlso            <https://w3id.org/foops/test/FIND_3_BIS> ;
        rdfs:subClassOf         <https://purl.org/oquo-foops#OntologyLevelFOOPSIssue> ;
        skos:definition         "The metadata of the ontology are not kept in a persistent public registry, so they would not remain accessible if the ontology became unavailable."@en ;
        oquo:hasRecommendation  "Register the ontology in a persistent public metadata registry, such as Linked Open Vocabularies, so that its metadata remain accessible even if the ontology itself is no longer available."@en .

