<https://purl.org/oquo-foops#MinimumMetadataMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology declares the minimum metadata required to ease its findability."@en ;
        rdfs:label       "minimum metadata metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/OM1> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F2Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#MinimumMetadataMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:F2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology metadata include a minimum set of fields: title, description, license, version IRI, creator and namespace URI. Each field is checked by a separate test. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle F2."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/OM1"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "OM1" .

