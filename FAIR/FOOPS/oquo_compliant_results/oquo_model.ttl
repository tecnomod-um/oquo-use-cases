oquo:NominalToCardinalScalePointMapping
        a                owl:Class ;
        rdfs:comment     "Represents the mapping of a category of a nominal scale onto a value of a cardinal scale." ;
        rdfs:label       "nominal to cardinal scale point mapping" ;
        rdfs:subClassOf  oquo:ScalePointMapping ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               om-1:Measurement_scale_category ;
                           owl:onProperty            oquo:hasInputScaleCategory ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onDataRange           xsd:double ;
                           owl:onProperty            oquo:hasOutputCardinalValue ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        obo:IAO_0000112  "A metric that reports the type of license of an ontology on a nominal scale (e.g. CC0, CC BY, proprietary, none) can be converted into a percentage of compliance with four mappings, such as CC0 onto 100, CC BY onto 100, proprietary onto 40 and none onto 0." ;
        obo:IAO_0000115  "A scale point mapping that converts a category of an input nominal scale into a value of an output cardinal scale. Each mapping has exactly one input scale category (hasInputScaleCategory) and one output cardinal value (hasOutputCardinalValue): every quality value that corresponds to the input category is converted into the output value. A nominal to cardinal scale conversion contains one of these mappings for each category of the input scale. Since the categories of a nominal scale are not ordered, the output values express the judgement of the quality model on how each category contributes to quality. The output values should fall within the boundaries of the output scale." .

oquo-fair-qm:R1_3Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata meet domain-relevant community standards."@en ;
        rdfs:label       "FAIR R1.3 domain-relevant community standards characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the resource and its metadata comply with the standards and good practices agreed by the community of the domain in which they are used, regarding format, organisation, vocabulary and metadata. For ontologies, this may involve adhering to community guidelines such as the OBO Foundry principles or the metadata recommendations of specific ontology repositories."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/r1-3"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "R1.3" .

<https://purl.org/oquo-foops#VersionIRIDeclaredMetricScaleToPercentageScaleConversion>
        a                          owl:NamedIndividual , oquo:CardinalToCardinalScaleConversion ;
        rdfs:comment               "The definition of the conversion between the scales <https://purl.org/oquo-foops#VersionIRIDeclaredMetricScale> and <https://purl.org/oquo-fair-qm#PercentageScale>."@en ;
        rdfs:label                 "version IRI declared metric scale to FAIR percentage scale conversion"@en ;
        oquo:hasInputScale         <https://purl.org/oquo-foops#VersionIRIDeclaredMetricScale> ;
        oquo:hasOutputScale        oquo-fair-qm:PercentageScale ;
        oquo:hasScalePointMapping  <https://purl.org/oquo-foops#VersionIRIDeclaredMetricScaleToPercentageScaleMapping> .

<https://purl.org/oquo-foops#MinimumMetadataMetricScale>
        a                               owl:NamedIndividual , om-1:Ratio_scale , oquo:RawScale ;
        rdfs:label                      "minimum metadata metric scale"@en ;
        obo:IAO_0000115                 "Raw scale of the minimum metadata metric: the ratio between the tests passed and the tests run by the FOOPS! check OM1, ranging from 0 (no test passed) to 1 (all tests passed)."@en ;
        QualityModel:hasLowerBoundary   "0"^^xsd:decimal ;
        QualityModel:hasRankigFunction  QualityModel:HigherBest ;
        QualityModel:hasUpperBoundary   "1"^^xsd:decimal .

<https://purl.org/oquo-foops#FOOPSIssue>
        a                owl:Class ;
        rdfs:label       "FOOPS! issue"@en ;
        rdfs:subClassOf  oquo:IssueByNonConformity ;
