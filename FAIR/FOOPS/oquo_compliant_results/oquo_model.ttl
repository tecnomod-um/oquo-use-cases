<https://purl.org/oquo-foops#PersistentURLMetricScale>
        a                               owl:NamedIndividual , om-1:Ratio_scale , oquo:RawScale ;
        rdfs:label                      "persistent URL metric scale"@en ;
        obo:IAO_0000115                 "Raw scale of the persistent URL metric: the ratio between the tests passed and the tests run by the FOOPS! check PURL1, ranging from 0 (no test passed) to 1 (all tests passed)."@en ;
        QualityModel:hasLowerBoundary   "0"^^xsd:decimal ;
        QualityModel:hasRankigFunction  QualityModel:HigherBest ;
        QualityModel:hasUpperBoundary   "1"^^xsd:decimal .

QualityModel:HigherBest
        a             owl:Thing , owl:NamedIndividual , QualityModel:RankingFunction ;
        rdfs:comment  "A ranking function that denotes that a higher value is better." ;
        rdfs:label    "HigherBest" .

dc:publisher  a          owl:AnnotationProperty ;
        rdfs:comment     "Examples of a Publisher include a person, an organization, or a service. Typically, the name of a Publisher should be used to indicate the entity."@en-us ;
        rdfs:label       "Publisher"@en-us ;
        skos:definition  "An entity responsible for making the resource available."@en-us .

