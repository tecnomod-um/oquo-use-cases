<https://purl.org/oquo-foops#RecommendedMetadataMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology declares a set of recommended metadata fields."@en ;
        rdfs:label       "recommended metadata metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/OM2> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#RecommendedMetadataMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1Characteristic
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology metadata include a set of recommended fields that enrich its documentation: namespace prefix, version information, creation date and citation, contributors being optional. Each field is checked by a separate test. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle R1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/OM2"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "OM2" .

<http://purl.org/net/EvaluationResult#EvaluationData>
        a                owl:Class ;
        rdfs:comment     "Evaluation data is any data that is used as an input in an evaluation process." ;
        rdfs:label       "EvaluationData" ;
        rdfs:subClassOf  prov:Entity .

<https://purl.org/oquo-foops#ContentNegotiationMetricScaleToPercentageScaleConversion>
        a                          owl:NamedIndividual , oquo:CardinalToCardinalScaleConversion ;
        rdfs:comment               "The definition of the conversion between the scales <https://purl.org/oquo-foops#ContentNegotiationMetricScale> and <https://purl.org/oquo-fair-qm#PercentageScale>."@en ;
        rdfs:label                 "content negotiation metric scale to FAIR percentage scale conversion"@en ;
        oquo:hasInputScale         <https://purl.org/oquo-foops#ContentNegotiationMetricScale> ;
        oquo:hasOutputScale        oquo-fair-qm:PercentageScale ;
        oquo:hasScalePointMapping  <https://purl.org/oquo-foops#ContentNegotiationMetricScaleToPercentageScaleMapping> .

oquo:hasIntercept  a     owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:comment     "The intercept of the linear function of a cardinal to cardinal scale point mapping, i.e. the value added after multiplying the input value by the slope." ;
        rdfs:domain      oquo:CardinalToCardinalScalePointMapping ;
        rdfs:label       "has intercept" ;
        rdfs:range       xsd:double ;
        obo:IAO_0000112  "The value 100 in the mapping that converts a lower-best interval [0, 1] into a higher-best percentage scale (output = -100 * input + 100)." ;
        obo:IAO_0000115  "Relates a cardinal to cardinal scale point mapping with the intercept of the linear function it applies (output = slope * input + intercept). The intercept is the constant added to a raw value falling within the input cardinal interval of the mapping after multiplying it by the slope, and corresponds to the output value that the function would yield for an input value of 0. It allows shifting the output values, for instance to invert a scale in combination with a negative slope, or to set the constant output value of a mapping whose slope is 0. Each cardinal to cardinal scale point mapping has exactly one intercept." .

<https://purl.org/oquo-data/metric-02910fa2-938f-44b6-a744-b98aef8b2f8b>
        a                      <http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#Measurement> , <https://purl.org/oquo-foops#OpenProtocolMetric> ;
