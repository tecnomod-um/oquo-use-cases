oquo-fair-qm:R1_2Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata are associated with detailed provenance."@en ;
        rdfs:label       "FAIR R1.2 detailed provenance characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the resource and its metadata are associated with detailed provenance information describing where they come from, who created or contributed to them, how and when they were generated, and how they have evolved. For ontologies, this includes their creators and contributors, creation and modification dates, version information, prior versions, and the sources of the definitions of their entities, preferably expressed with standard vocabularies (e.g. Dublin Core, PROV-O or PAV)."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/r1-2"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "R1.2" .

