        a       <http://www.w3.org/2006/time#Instant> ;
        <http://www.w3.org/2006/time#inXSDDateTime>
                "2026-11-25T13:41:55Z"^^xsd:dateTime .

<https://purl.org/oquo-foops#HTMLDocumentationMetricScaleToPercentageScaleMapping>
        a                              owl:NamedIndividual , oquo:CardinalToCardinalScalePointMapping ;
        rdfs:label                     "mapping [0.0..1.0] -> 100 * x + 0"@en ;
        oquo:hasInputCardinalInterval  <https://purl.org/oquo-foops#ClosedUnitInterval> ;
        oquo:hasIntercept              "0.0"^^xsd:double ;
        oquo:hasSlope                  "100.0"^^xsd:double .

om-1:rank  a                    owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain             om-1:Ordered_measurement_scale_category ;
        rdfs:label              "rank"@en ;
        rdfs:range              xsd:integer ;
        om-1:alternative_label  "has rank"@en .

oquo:OrdinalToCardinalScalePointMapping
        a                owl:Class ;
        rdfs:comment     "Represents the mapping of a category of an ordinal scale onto a value of a cardinal scale." ;
        rdfs:label       "ordinal to cardinal scale point mapping" ;
        rdfs:subClassOf  oquo:ScalePointMapping ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               QualityModel:OrdinalScaleItem ;
                           owl:onProperty            oquo:hasInputScaleCategory ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onDataRange           xsd:double ;
                           owl:onProperty            oquo:hasOutputCardinalValue ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        obo:IAO_0000112  "A metric whose raw values are measured on an ordinal scale with categories of ranks 0, 3 and 9 can be converted into a percentage scale from 0 to 100 with three mappings: the category with rank 0 onto 0, the category with rank 3 onto 33.33, and the category with rank 9 onto 100." ;
        obo:IAO_0000115  "A scale point mapping that converts a category of an input ordinal scale into a value of an output cardinal scale. Each mapping has exactly one input scale category (hasInputScaleCategory) and one output cardinal value (hasOutputCardinalValue): every quality value that corresponds to the input category is converted into the output value. An ordinal to cardinal scale conversion contains one of these mappings for each category of the input scale, thus assigning a numeric value to every category. The output values should respect the order of the categories of the input scale and fall within the boundaries of the output scale." .

QualityModel:measuresCharacteristic
        a             owl:ObjectProperty ;
        rdfs:comment  "Denotes a quality characteristic that is measured with a quality measure." ;
        rdfs:domain   QualityModel:QualityMeasure ;
        rdfs:label    "measuresCharacteristic" ;
        rdfs:range    QualityModel:QualityCharacteristic .

<https://purl.org/oquo-foops#MissingDistinctVersionIRIIssue>
        a                       owl:Class ;
        rdfs:label              "missing distinct version IRI issue"@en ;
        rdfs:seeAlso            <https://w3id.org/foops/test/VER1> ;
        rdfs:subClassOf         <https://purl.org/oquo-foops#OntologyLevelFOOPSIssue> ;
        skos:definition         "The ontology metadata do not declare a version IRI, or the version IRI is equal to the ontology URI."@en ;
        oquo:hasRecommendation  "Declare a version IRI (owl:versionIRI) that identifies the specific version of the ontology and differs from the ontology URI, e.g. by including the version number or the release date."@en .

