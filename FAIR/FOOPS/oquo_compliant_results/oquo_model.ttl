oquo-fair-qm:I1Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata use a formal, accessible, shared and broadly applicable knowledge representation language."@en ;
        rdfs:label       "FAIR I1 formal knowledge representation language characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the resource and its metadata are expressed in a formal, accessible, shared and broadly applicable language for knowledge representation, so that they can be exchanged and interpreted by humans and machines without specialised algorithms or translators. For ontologies, this corresponds to the use of W3C standard languages and serialisations, such as RDF, RDFS and OWL, and to the absence of syntactic and logical errors that would prevent their correct processing."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/i1"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "I1" .

om-1:percent  a              owl:NamedIndividual , om-1:Unit_of_measure ;
        rdfs:comment         "Unit of measure representing one hundredth of a whole."@en ;
        rdfs:label           "percent"@en ;
        QualityModel:symbol  "%" .

oquo-fair-qm:R1Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata are described with a plurality of accurate and relevant attributes."@en ;
        rdfs:label       "FAIR R1 richly described with accurate and relevant attributes characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:R1_2Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:R1_3Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-fair-qm:R1_1Characteristic oquo-fair-qm:R1_2Characteristic oquo-fair-qm:R1_3Characteristic )
                                              ] ;
                           owl:onProperty     QualityModel:hasSubCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:R1_1Characteristic
                         ] ;
        obo:IAO_0000115  "Degree to which the resource and its metadata are described with a plurality of accurate and relevant attributes, enabling users to decide whether the resource is useful in a particular context. Whereas F2 focuses on metadata that support discovery, R1 focuses on metadata that support reuse, such as the scope and intended use of the resource, its limitations, or the documentation of its entities through labels, definitions and synonyms. It is refined by the subcharacteristics R1.1, R1.2 and R1.3."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/r1"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "R1" .

obo:IAO_0000111  a        owl:AnnotationProperty ;
