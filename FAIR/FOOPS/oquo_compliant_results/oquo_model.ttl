        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasInputScale ;
                           owl:someValuesFrom  om-1:Cardinal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
