        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:F1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        obo:IAO_0000115  "This metric checks whether the version IRI declared in the ontology metadata resolves to the corresponding version of the ontology. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle F1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/VER2"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
