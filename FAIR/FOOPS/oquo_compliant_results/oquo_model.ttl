prov:used  a                owl:ObjectProperty ;
        rdfs:comment        "A prov:Entity that was used by this prov:Activity. For example, :baking prov:used :spoon, :egg, :oven ."@en ;
        rdfs:domain         prov:Activity ;
        rdfs:isDefinedBy    <http://www.w3.org/ns/prov-o#> ;
        rdfs:label          "used" ;
        rdfs:range          prov:Entity ;
        rdfs:subPropertyOf  prov:wasInfluencedBy ;
        prov:category       "starting-point" ;
        prov:component      "entities-activities" ;
        prov:inverse        "wasUsedBy" ;
        prov:qualifiedForm  prov:Usage , prov:qualifiedUsage .

oquo:hasSlope  a         owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:comment     "The slope of the linear function of a cardinal to cardinal scale point mapping, i.e. the factor by which input values are multiplied." ;
        rdfs:domain      oquo:CardinalToCardinalScalePointMapping ;
        rdfs:label       "has slope" ;
        rdfs:range       xsd:double ;
        obo:IAO_0000112  "The value 100 in the mapping that converts the interval [0, 1] into a percentage scale (output = 100 * input + 0)." ;
        obo:IAO_0000115  "Relates a cardinal to cardinal scale point mapping with the slope of the linear function it applies (output = slope * input + intercept). The slope is the factor by which a raw value falling within the input cardinal interval of the mapping is multiplied before adding the intercept, and therefore determines how much the output value changes for each unit of change in the input value. A positive slope preserves the direction of the input scale, a negative slope inverts it (e.g. to convert a lower-best scale into a higher-best one), and a slope of 0 maps every value of the input interval onto the same output value, given by the intercept. Each cardinal to cardinal scale point mapping has exactly one slope." .

