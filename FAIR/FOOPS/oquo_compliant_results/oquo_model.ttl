<https://purl.org/oquo-foops#foops-software-agent>
        a                      owl:NamedIndividual , prov:SoftwareAgent ;
        rdfs:comment           "Software that implements FOOPS! and runs its FAIR checks on ontologies."@en ;
        rdfs:label             "foops software agent" ;
        rdfs:seeAlso           <https://doi.org/10.5281/zenodo.14767999> ;
        obo:IAO_0000115        "The software implementation of FOOPS! (Ontology Pitfall Scanner for FAIR), a service that assesses whether an ontology or vocabulary (OWL or SKOS) complies with the FAIR principles. Given the IRI or the file of an ontology, it runs a set of checks, each one associated with a FAIR principle (Findable, Accessible, Interoperable and Reusable), on the ontology and its metadata, and reports which checks pass and an overall score. It acts as the agent of the evaluations whose results are described with this module."@en ;
        obo:IAO_0000119        "Garijo, D., Corcho, O. and Poveda-Villalón, M. (2021). FOOPS!: An Ontology Pitfall Scanner for the FAIR Principles. In ISWC 2021: Posters, Demos, and Industry Tracks. CEUR Workshop Proceedings, vol. 2980."@en ;
        dc:creator             <https://orcid.org/0000-0003-0454-7145> , <https://orcid.org/0000-0003-3587-0367> , <https://orcid.org/0000-0002-9260-0753> ;
        dc:source              <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        schema:codeRepository  <https://github.com/oeg-upm/fair_ontologies> ;
        foaf:homepage          <https://w3id.org/foops/> .

prov:sharesDefinitionWith
        a                 owl:AnnotationProperty ;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#> .

oquo-fair-qm:FindableCharacteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata can be discovered by humans and machines."@en ;
        rdfs:label       "FAIR findable characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:F1Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  [ a            owl:Class ;
                                                owl:unionOf  ( oquo-fair-qm:F1Characteristic oquo-fair-qm:F2Characteristic oquo-fair-qm:F3Characteristic oquo-fair-qm:F4Characteristic )
                                              ] ;
                           owl:onProperty     QualityModel:hasSubCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:F4Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:F3Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:F2Characteristic
                         ] ;
        obo:IAO_0000115  "Degree to which the evaluated resource and its metadata can be easily discovered by both humans and software agents. Findability is the first step towards any reuse and relies on the resource having a globally unique and persistent identifier, being described with rich metadata that explicitly reference that identifier, and being registered or indexed in searchable resources, so that machine-readable metadata enable the automatic discovery of the resource. It is assessed through the subcharacteristics F1 to F4."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/fair-principles"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "F" .

<https://purl.org/oquo-foops#VersionIRIDeclaredMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology declares a version IRI distinct from the ontology URI."@en ;
        rdfs:label       "version IRI declared metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/VER1> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F1Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#VersionIRIDeclaredMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:F1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology metadata declare a version IRI and whether it is different from the ontology URI, so that each version of the ontology has its own identifier. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle F1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/VER1"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "VER1" .

