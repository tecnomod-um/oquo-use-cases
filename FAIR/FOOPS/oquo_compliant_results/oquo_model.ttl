QualityModel:QualityIndicator
        a                owl:Class ;
        rdfs:comment     "Quality indicator is a quality measure that is obtained by combining base and/or derived measures. Unlike base and derived measures, quality indicators are related to a set of tests in the evaluation." ;
        rdfs:label       "QualityIndicator" ;
        rdfs:subClassOf  QualityModel:QualityMeasure .

