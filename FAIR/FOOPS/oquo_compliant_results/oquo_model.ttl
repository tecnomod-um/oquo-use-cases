QualityModel:QualityMeasure
        a                owl:Class ;
        rdfs:comment     "Quality measure is any measure that captures information about a specific quality characteristic related to a specific product, service or action." ;
        rdfs:label       "QualityMeasure" ;
        rdfs:subClassOf  <http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#Measurement> .

oquo-fair-qm:F3Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the metadata explicitly include the identifier of the resource they describe."@en ;
        rdfs:label       "FAIR F3 metadata include data identifier characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the metadata explicitly and unambiguously state the identifier of the resource they describe, so that the link between metadata and resource is preserved when they are stored or exchanged separately. For an ontology, this means that metadata records (e.g. in a registry or in a separate metadata file) include the ontology IRI and, where applicable, the version IRI."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/f3"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "F3" .

<https://purl.org/oquo-core>
        a                              <http://purl.org/net/EvaluationResult#EvaluationSubject> , oquo:EvaluationInputData , <http://purl.org/net/EvaluationResult#EvaluationData> , <http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#Entity> , <http://purl.org/ipo/core#Asset> , owl:Ontology ;
        dc:contributor                 <https://orcid.org/0000-0003-0487-308X> , <https://orcid.org/0009-0008-4226-2582> , <https://orcid.org/0000-0002-7558-2880> , <https://orcid.org/0000-0003-0201-3115> , <https://orcid.org/0000-0003-3641-7548> , <https://orcid.org/0000-0001-6233-6384> ;
        dc:creator                     <https://orcid.org/0000-0003-0201-3115> ;
        dc:description                 "OQUO (Ontology QUality Ontology) is a framework-agnostic ontology for describing quality models for ontologies and the results of ontology quality evaluations in a common, machine-readable format. The OQUO core provides the general vocabulary needed to define quality models, consisting of quality characteristics and subcharacteristics, the metrics that measure them and the scales on which they are measured, together with the conversions between raw metric scales and the scales of quality models, which can be defined as cardinal to ordinal, cardinal to nominal, ordinal to ordinal and cardinal to cardinal mappings. It also represents the results of quality evaluations, including the observations made on the evaluated entities, the measured values, the evaluation context and configuration, and the issues detected, classified by severity and by non conformity. Specific quality models (e.g. OQuaRE or FAIR) are defined in separate modules that extend the core, and the metrics, raw scales and issue types of concrete evaluation frameworks are described in further modules that extend those quality models, so that the results of independently developed tools can be represented, compared and aggregated within a single model. OQUO reuses existing ontologies such as the Quality Model Ontology (QMO), the Evaluation Ontology (EVAL), the Extensible Observation Ontology (OBOE), and the Information Problem Ontology (IPO)."@en ;
        dc:publisher                   "Universidad de Murcia" ;
        dc:title                       "OQUO core"@en ;
        terms:created                  "2023-04-21"^^xsd:date ;
        terms:license                  <http://www.apache.org/licenses/LICENSE-2.0> ;
        <http://purl.org/ipo/core#hostAssetOf>
                <https://purl.org/oquo-data/issue-048f0108-ccd3-40f4-9419-651c0302a402> , <https://purl.org/oquo-data/issue-aee38fcd-3897-49bc-98d2-af132330c6c0> , <https://purl.org/oquo-data/issue-1799f894-67fb-44b1-83f9-817c018387f4> , <https://purl.org/oquo-data/issue-3ab3dcf4-9c52-4129-bf29-32cb27916cc7> , <https://purl.org/oquo-data/issue-bb68fa07-246e-4e17-bbe0-d8cc48ceb396> , <https://purl.org/oquo-data/issue-5bab2ce9-8013-4c86-8dcb-ca7ef466f2ad> , <https://purl.org/oquo-data/issue-e6dda7a6-dac7-40bc-a9f9-45dee1b6f66f> , <https://purl.org/oquo-data/issue-8862d73c-a248-4667-b44d-c41164a1a598> ;
        vann:preferredNamespacePrefix  "oquo" ;
        vann:preferredNamespaceUri     "https://purl.org/oquo#" ;
        owl:versionIRI                 <https://purl.org/oquo-core/v2.2.2> .

