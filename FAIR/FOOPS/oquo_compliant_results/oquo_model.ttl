<https://purl.org/oquo-foops#VersionIRIResolvableMetricScale>
        a                               owl:NamedIndividual , om-1:Ratio_scale , oquo:RawScale ;
        rdfs:label                      "version IRI resolvable metric scale"@en ;
        obo:IAO_0000115                 "Raw scale of the version IRI resolvable metric: the ratio between the tests passed and the tests run by the FOOPS! check VER2, ranging from 0 (no test passed) to 1 (all tests passed)."@en ;
        QualityModel:hasLowerBoundary   "0"^^xsd:decimal ;
        QualityModel:hasRankigFunction  QualityModel:HigherBest ;
        QualityModel:hasUpperBoundary   "1"^^xsd:decimal .

<https://purl.org/oquo-foops#MetadataAccessibleWithoutOntologyMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the metadata of the ontology remain accessible even if the ontology itself becomes unavailable."@en ;
        rdfs:label       "metadata accessible without ontology metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/FIND_3_BIS> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:A2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:A2Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#MetadataAccessibleWithoutOntologyMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "This metric checks whether the metadata of the ontology are kept in a persistent public registry, such as Linked Open Vocabularies (LOV), so that they remain accessible even if the ontology itself is no longer available. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle A2."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/FIND_3_BIS"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "FIND_3_BIS" .

<https://purl.org/oquo-foops#VocabularyReuseMetricScaleToPercentageScaleConversion>
        a                          owl:NamedIndividual , oquo:CardinalToCardinalScaleConversion ;
        rdfs:comment               "The definition of the conversion between the scales <https://purl.org/oquo-foops#VocabularyReuseMetricScale> and <https://purl.org/oquo-fair-qm#PercentageScale>."@en ;
        rdfs:label                 "vocabulary reuse metric scale to FAIR percentage scale conversion"@en ;
        oquo:hasInputScale         <https://purl.org/oquo-foops#VocabularyReuseMetricScale> ;
        oquo:hasOutputScale        oquo-fair-qm:PercentageScale ;
        oquo:hasScalePointMapping  <https://purl.org/oquo-foops#VocabularyReuseMetricScaleToPercentageScaleMapping> .

<https://purl.org/oquo-foops#MinimumMetadataMetricScaleToPercentageScaleConversion>
        a                          owl:NamedIndividual , oquo:CardinalToCardinalScaleConversion ;
        rdfs:comment               "The definition of the conversion between the scales <https://purl.org/oquo-foops#MinimumMetadataMetricScale> and <https://purl.org/oquo-fair-qm#PercentageScale>."@en ;
        rdfs:label                 "minimum metadata metric scale to FAIR percentage scale conversion"@en ;
        oquo:hasInputScale         <https://purl.org/oquo-foops#MinimumMetadataMetricScale> ;
        oquo:hasOutputScale        oquo-fair-qm:PercentageScale ;
        oquo:hasScalePointMapping  <https://purl.org/oquo-foops#MinimumMetadataMetricScaleToPercentageScaleMapping> .

<https://purl.org/oquo-foops#LicenseResolvableMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the license of the ontology is identified by a resolvable URL."@en ;
        rdfs:label       "license resolvable metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/OM4.2> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1_1Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#LicenseResolvableMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1_1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "This metric checks whether the license declared in the ontology metadata is identified by a URL that resolves to the license document, so that users can verify the terms of use. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle R1.1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/OM4.2"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "OM4.2" .

skos:definition  a        owl:AnnotationProperty ;
        rdfs:isDefinedBy  <http://www.w3.org/2004/02/skos/core> ;
        rdfs:label        "definition"@en ;
        skos:definition   "A statement or formal explanation of the meaning of a concept."@en .

<https://purl.org/oquo-foops#RecommendedMetadataMetricScale>
        a                               owl:NamedIndividual , om-1:Ratio_scale , oquo:RawScale ;
        rdfs:label                      "recommended metadata metric scale"@en ;
        obo:IAO_0000115                 "Raw scale of the recommended metadata metric: the ratio between the tests passed and the tests run by the FOOPS! check OM2, ranging from 0 (no test passed) to 1 (all tests passed)."@en ;
        QualityModel:hasLowerBoundary   "0"^^xsd:decimal ;
        QualityModel:hasRankigFunction  QualityModel:HigherBest ;
        QualityModel:hasUpperBoundary   "1"^^xsd:decimal .

