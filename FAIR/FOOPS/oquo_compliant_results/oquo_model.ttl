        rdfs:label          "hasCausativeAsset"@en ;
        rdfs:subPropertyOf  <http://purl.org/ipo/core#hasAsset> .

<https://purl.org/oquo-data/instant-44ba4e0d-49fc-4c36-83b5-a8010c3ab359>
