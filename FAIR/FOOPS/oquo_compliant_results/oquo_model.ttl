<https://purl.org/oquo-foops#OpenProtocolMetric>
        a                owl:Class ;
        rdfs:comment     "Whether the ontology is accessible through an open protocol such as HTTP or HTTPS."@en ;
        rdfs:label       "open protocol metric"@en ;
        rdfs:seeAlso     <https://w3id.org/foops/metric/HTTP1> ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:A1_1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:A1_1Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-foops#OpenProtocolMetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "This metric checks whether the ontology is retrieved through an open, free and universally implementable protocol, such as HTTP or HTTPS. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle A1.1."@en ;
        obo:IAO_0000119  "FOOPS!, https://w3id.org/foops/metric/HTTP1"@en ;
        dc:source        <http://ceur-ws.org/Vol-2980/paper321.pdf> ;
        rdf1:acronym     "HTTP1" .

terms:isVersionOf  a       owl:AnnotationProperty ;
        rdfs:comment       "A related resource of which the described resource is a version, edition, or adaptation."@en ;
        rdfs:isDefinedBy   terms: ;
        rdfs:label         "Is Version Of"@en ;
        terms:description  "Changes in version imply substantive changes in content rather than differences in format. This property is intended to be used with non-literal values. This property is an inverse property of Has Version."@en .

QualityModel:DerivedMeasure
        a                owl:Class ;
        rdfs:comment     "Derived measure is a measure that is obtained in an individual evaluation test by combining base measures." ;
        rdfs:label       "DerivedMeasure" ;
        rdfs:subClassOf  QualityModel:QualityMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  oquo:RawScale
                         ] .

oquo:IntervalBoundType
        a                    owl:Class ;
        rdfs:comment         "The interval bounds, which can be open () or closed []." ;
        rdfs:label           "interval bound type" ;
        owl:equivalentClass  [ a          owl:Class ;
                               owl:oneOf  ( oquo:ClosedIntervalBound oquo:OpenIntervalBound )
                             ] .

<http://purl.org/ipo/core#causativeAssetOf>
        a                   owl:ObjectProperty ;
        rdfs:comment        "This property relates a Asset with a Issue caused by this Asset. For example, a virus associated with a disease caused by it."@en ;
        rdfs:isDefinedBy    <http://purl.org/ipo/core> ;
        rdfs:label          "causativeAssetOf"@en ;
        rdfs:subPropertyOf  <http://purl.org/ipo/core#assetOf> ;
        owl:inverseOf       <http://purl.org/ipo/core#hasCausativeAsset> .

<https://purl.org/oquo-foops#TermLevelFOOPSIssue>
        a                owl:Class ;
        rdfs:label       "term level FOOPS! issue"@en ;
        rdfs:subClassOf  <https://purl.org/oquo-foops#FOOPSIssue> ;
        skos:definition  "FOOPS! issue affecting a single term of the ontology (a class, property, individual or SKOS concept within the namespace of the ontology), whose host asset is that term. One issue of this kind is reported for each term listed by FOOPS! as an affected element of a failed check."@en .

<https://purl.org/oquo-foops#MetadataVocabularyReuseMetricScaleToPercentageScaleConversion>
        a                          owl:NamedIndividual , oquo:CardinalToCardinalScaleConversion ;
        rdfs:comment               "The definition of the conversion between the scales <https://purl.org/oquo-foops#MetadataVocabularyReuseMetricScale> and <https://purl.org/oquo-fair-qm#PercentageScale>."@en ;
        rdfs:label                 "metadata vocabulary reuse metric scale to FAIR percentage scale conversion"@en ;
        oquo:hasInputScale         <https://purl.org/oquo-foops#MetadataVocabularyReuseMetricScale> ;
        oquo:hasOutputScale        oquo-fair-qm:PercentageScale ;
