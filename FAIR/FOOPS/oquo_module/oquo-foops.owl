<?xml version="1.0"?>
<rdf:RDF xmlns="https://purl.org/oquo-foops#"
     xml:base="https://purl.org/oquo-foops"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:om-1="http://www.wurvoc.org/vocabularies/om-1.8/"
     xmlns:rdf1="http://www.cropontology.org/rdf/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oquo="https://purl.org/oquo#"
     xmlns:oquo-fair-qm="https://purl.org/oquo-fair-qm#"
     xmlns:QualityModel="http://purl.org/net/QualityModel#">
    <owl:Ontology rdf:about="https://purl.org/oquo-foops">
        <owl:imports rdf:resource="https://purl.org/oquo-fair-qm"/>
        <dc:title xml:lang="en">OQUO FOOPS! module</dc:title>
        <dc:description xml:lang="en">OQUO extension module that describes the metrics of FOOPS! (Ontology Pitfall Scanner for FAIR), their raw scales and the conversions of these raw scales into the percentage scale of the OQUO FAIR quality model. Each FOOPS! check is represented as a metric linked to the FAIR subcharacteristic it assesses, whose raw value is the ratio between the passed and run tests of the check. The module also defines the types of issues of non conformity that FOOPS! can report: one ontology level issue per failed check, and one term level issue per term affected by the checks on term labels and definitions.</dc:description>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-29</terms:created>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <vann:preferredNamespacePrefix>oquo-foops</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://purl.org/oquo-foops#</vann:preferredNamespaceUri>
        <rdfs:seeAlso rdf:resource="https://w3id.org/foops/"/>
        <rdfs:seeAlso rdf:resource="https://github.com/oeg-upm/fair_ontologies"/>
        <obo:IAO_0000116 xml:lang="en">The definitions of the metrics are adapted from the FOOPS! metric descriptions (https://w3id.org/foops/catalog, CC BY 4.0). Each metric is linked through rdfs:seeAlso to the corresponding FOOPS! metric, and each issue type to the FOOPS! test that reports it. The IRI of the test is the id returned by FOOPS! for each check in its results, and the IRI of the metric it implements follows the same pattern, replacing /test/ with /metric/ (e.g. https://w3id.org/foops/test/PURL1 and https://w3id.org/foops/metric/PURL1).</obo:IAO_0000116>
    </owl:Ontology>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->




    <!-- http://www.w3.org/2000/01/rdf-schema#seeAlso -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->



    <!-- https://purl.org/oquo-foops#BasicProvenanceMetadataMetric -->

    <owl:Class rdf:about="https://purl.org/oquo-foops#BasicProvenanceMetadataMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#R1_2Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#R1_2Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-foops#BasicProvenanceMetadataMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">This metric checks whether the ontology metadata include basic provenance information, namely the author and the creation date, which are mandatory; contributors and previous version are recommended but not required. Each mandatory field is checked by a separate test. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle R1.2.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">FOOPS!, https://w3id.org/foops/metric/OM5.1</obo:IAO_0000119>
        <rdf1:acronym>OM5.1</rdf1:acronym>
        <rdfs:comment xml:lang="en">Whether the ontology declares basic provenance metadata (author and creation date).</rdfs:comment>
        <rdfs:label xml:lang="en">basic provenance metadata metric</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/foops/metric/OM5.1"/>
    </owl:Class>



    <!-- https://purl.org/oquo-foops#ConsistentOntologyIDMetric -->

    <owl:Class rdf:about="https://purl.org/oquo-foops#ConsistentOntologyIDMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#F1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#F1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-foops#ConsistentOntologyIDMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">This metric checks whether the URI used to retrieve and assess the ontology is consistent with the ontology URI declared within the ontology document. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle F1.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">FOOPS!, https://w3id.org/foops/metric/URI2</obo:IAO_0000119>
        <rdf1:acronym>URI2</rdf1:acronym>
        <rdfs:comment xml:lang="en">Whether the URI used to access the ontology is consistent with the ontology URI declared in the document.</rdfs:comment>
        <rdfs:label xml:lang="en">consistent ontology ID metric</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/foops/metric/URI2"/>
    </owl:Class>



    <!-- https://purl.org/oquo-foops#ContentNegotiationMetric -->

    <owl:Class rdf:about="https://purl.org/oquo-foops#ContentNegotiationMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-foops#ContentNegotiationMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">This metric checks whether the ontology is served through content negotiation both as a human-readable HTML representation and in at least one recognised RDF serialisation, such as RDF/XML or Turtle. It runs two tests, one for the HTML representation and one for the RDF serialisations, and fails if any of them cannot be retrieved. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle A1.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">FOOPS!, https://w3id.org/foops/metric/CN1</obo:IAO_0000119>
        <rdf1:acronym>CN1</rdf1:acronym>
        <rdfs:comment xml:lang="en">Whether the ontology can be retrieved both as HTML and in a recognised RDF serialisation.</rdfs:comment>
        <rdfs:label xml:lang="en">content negotiation metric</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/foops/metric/CN1"/>
    </owl:Class>



    <!-- https://purl.org/oquo-foops#DetailedMetadataMetric -->

    <owl:Class rdf:about="https://purl.org/oquo-foops#DetailedMetadataMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#R1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#R1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-foops#DetailedMetadataMetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">This metric checks whether the ontology metadata include a set of detailed fields: DOI, publisher, logo, status, source and issued date. Previous version, backward compatibility and modification date are also inspected but their absence is not penalised. Each mandatory field is checked by a separate test. The raw value of the metric is the ratio between the number of tests passed and the number of tests run by FOOPS! for this check (total_passed_tests / total_tests_run), so it ranges from 0 to 1 and higher values are better. It measures FAIR principle R1.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">FOOPS!, https://w3id.org/foops/metric/OM3</obo:IAO_0000119>
        <rdf1:acronym>OM3</rdf1:acronym>
        <rdfs:comment xml:lang="en">Whether the ontology declares a set of detailed metadata fields.</rdfs:comment>
        <rdfs:label xml:lang="en">detailed metadata metric</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/foops/metric/OM3"/>
    </owl:Class>



    <!-- https://purl.org/oquo-foops#DetailedProvenanceMetadataMetric -->

    <owl:Class rdf:about="https://purl.org/oquo-foops#DetailedProvenanceMetadataMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
