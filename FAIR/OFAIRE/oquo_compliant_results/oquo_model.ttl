oquo-fair-qm:I1Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata use a formal, accessible, shared and broadly applicable knowledge representation language."@en ;
        rdfs:label       "FAIR I1 formal knowledge representation language characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the resource and its metadata are expressed in a formal, accessible, shared and broadly applicable language for knowledge representation, so that they can be exchanged and interpreted by humans and machines without specialised algorithms or translators. For ontologies, this corresponds to the use of W3C standard languages and serialisations, such as RDF, RDFS and OWL, and to the absence of syntactic and logical errors that would prevent their correct processing."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/i1"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "I1" .

