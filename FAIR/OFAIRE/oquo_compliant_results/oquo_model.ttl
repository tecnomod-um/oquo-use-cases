                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F4Characteristic
                         ] ;
        obo:IAO_0000115  "Are the ontology libraries or repositories properly indexed by Web search engines? This metric corresponds to the O'FAIRe question F4Q3, which assesses FAIR principle F4. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 8 (Full credits: the requirement of the question is fulfilled). This question is not implemented in the current version of O'FAIRe, which always gives it 0 credits with the explanation \"This question cannot be evaluated in the repository at this time.\""@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
