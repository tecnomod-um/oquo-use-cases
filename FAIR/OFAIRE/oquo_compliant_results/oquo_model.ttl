oquo:Interval  a         owl:Class ;
        rdfs:comment     "Class for representing numeric intervals, such as [1, 5)." ;
        rdfs:label       "interval" ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               oquo:IntervalBoundType ;
                           owl:onProperty            oquo:hasIntervalLowerBoundType ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               oquo:IntervalBoundType ;
                           owl:onProperty            oquo:hasIntervalUpperBoundType ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onDataRange           xsd:double ;
                           owl:onProperty            oquo:hasIntervalLowerValue ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onDataRange           xsd:double ;
                           owl:onProperty            oquo:hasIntervalUpperValue ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

