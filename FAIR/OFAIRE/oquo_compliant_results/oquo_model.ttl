<https://purl.org/oquo-ofaire#F2Q1Metric>
        a                owl:Class ;
        rdfs:comment     "Is the ontology described with additional 'MIRO must' metadata properties?"@en ;
        rdfs:label       "O'FAIRe F2Q1 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#F2Q1MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F2Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:F2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "Is the ontology described with additional 'MIRO must' metadata properties? This metric corresponds to the O'FAIRe question F2Q1, which assesses FAIR principle F2. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology is described with 0 'MIRO must' property); 2 (The ontology is described with 1 'MIRO must' property); 4 (The ontology is described with 2 'MIRO must' properties); 6 (The ontology is described with 3 'MIRO must' properties); 8 (The ontology is described with 4 'MIRO must' properties); 10 (The ontology is described with 5 'MIRO must' properties); 12 (The ontology is described with 6 'MIRO must' properties); 14 (The ontology is described with 7 'MIRO must' properties); 16 (The ontology is described with 8 or more 'MIRO must' properties)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "F2Q1" .

