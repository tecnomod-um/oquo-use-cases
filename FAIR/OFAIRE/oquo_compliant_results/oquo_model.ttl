oquo:NominalToCardinalScaleConversion
        a                owl:Class ;
        rdfs:comment     "Defines the conversion from a nominal scale to a cardinal scale." ;
        rdfs:label       "nominal to cardinal scale conversion" ;
        rdfs:subClassOf  oquo:ScaleConversion ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasInputScale ;
                           owl:someValuesFrom  om-1:Nominal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasOutputScale ;
                           owl:someValuesFrom  om-1:Cardinal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasScalePointMapping ;
                           owl:someValuesFrom  oquo:NominalToCardinalScalePointMapping
                         ] .

oquo:hasInputScaleCategory
        a             owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:comment  "Relationship between an ordinal to ordinal scale point mapping and a measurement scale category." ;
        rdfs:domain   [ a            owl:Class ;
                        owl:unionOf  ( oquo:NominalToCardinalScalePointMapping oquo:NominalToNominalScalePointMapping oquo:NominalToOrdinalScalePointMapping oquo:OrdinalToCardinalScalePointMapping oquo:OrdinalToNominalScalePointMapping oquo:OrdinalToOrdinalScalePointMapping )
                      ] ;
        rdfs:label    "has input scale category" ;
        rdfs:range    om-1:Measurement_scale_category .

<https://purl.org/oquo-ofaire#A1_1Q1Metric>
        a                owl:Class ;
        rdfs:comment     "Is the ontology relying on HTTP/URIs for its identification and access mechanisms?"@en ;
        rdfs:label       "O'FAIRe A1.1Q1 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#A1_1Q1MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:A1_1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:A1_1Characteristic
                         ] ;
        obo:IAO_0000115  "Is the ontology relying on HTTP/URIs for its identification and access mechanisms? This metric corresponds to the O'FAIRe question A1.1Q1, which assesses FAIR principle A1.1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 20 (The repository uses HTTP/URIs for identification and access mechanisms)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "A1.1Q1" .

