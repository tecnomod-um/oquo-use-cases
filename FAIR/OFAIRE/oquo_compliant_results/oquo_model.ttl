<https://purl.org/oquo-ofaire>
        a                              owl:Ontology ;
        rdfs:seeAlso                   <https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md> , <https://github.com/agroportal/fairness> ;
        obo:IAO_0000116                "The metrics, their credit levels and their explanations are generated from the questions.config.json file of O'FAIRe (https://github.com/agroportal/fairness, MIT License). O'FAIRe gives 0 credits to a question whenever it is not fulfilled or cannot be evaluated, so every scale includes a category with 0 credits even if O'FAIRe does not declare it."@en ;
        dc:contributor                 "Francisco Abad-Navarro" ;
        dc:creator                     "Francisco Abad-Navarro" ;
        dc:description                 "OQUO module that integrates O'FAIRe (Ontology FAIRness Evaluator), a framework that assesses the FAIRness of ontologies and semantic resources hosted in OntoPortal repositories, with the OQUO FAIR quality model. The module defines one metric for each of the 61 O'FAIRe questions and associates it with the FAIR subcharacteristic it assesses. The raw value of each metric is the number of credits obtained in the question, measured on an ordinal scale whose categories are the possible credit levels of the question, ranked by their number of credits. The module also defines the conversions of these ordinal scales into the percentage scale of the FAIR quality model, which assign to each level its credits divided by the maximum credits of the question, as a percentage. 10 of the questions are not implemented in the current version of O'FAIRe, which always gives them 0 credits."@en ;
        dc:publisher                   "Universidad de Murcia" ;
        dc:source                      "Amdouni, E., Bouazzouni, S., Jonquet, C. (2022). O'FAIRe makes you an offer: Metadata-based Automatic FAIRness Assessment for Ontologies and Semantic Resources. International Journal of Metadata, Semantics and Ontologies, Inderscience. https://hal.archives-ouvertes.fr/lirmm-03630233"@en ;
        dc:title                       "OQUO O'FAIRe module"@en ;
        terms:created                  "2026-11-05"^^xsd:date ;
        terms:license                  <http://www.apache.org/licenses/LICENSE-2.0> ;
        vann:preferredNamespacePrefix  "oquo-ofaire" ;
        vann:preferredNamespaceUri     "https://purl.org/oquo-ofaire#" ;
        owl:versionIRI                 <https://purl.org/oquo-ofaire/v1.0.0> .

<https://purl.org/oquo-ofaire#A1Q1Metric>
        a                owl:Class ;
        rdfs:comment     "Does the ontology URI and other identifiers, if exist, resolve to the ontology?"@en ;
        rdfs:label       "O'FAIRe A1Q1 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:A1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:A1Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#A1Q1MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "Does the ontology URI and other identifiers, if exist, resolve to the ontology? This metric corresponds to the O'FAIRe question A1Q1, which assesses FAIR principle A1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology provides 0 resolvable identifier); 3 (The ontology provides 1 resolvable identifier); 6 (The ontology provides 2 resolvable identifiers)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "A1Q1" .

