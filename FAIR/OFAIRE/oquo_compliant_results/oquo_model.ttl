<https://purl.org/oquo-ofaire#R1_1Q2Metric>
        a                owl:Class ;
        rdfs:comment     "Are the ontology access rights specified and permissions documented?"@en ;
        rdfs:label       "O'FAIRe R1.1Q2 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1_1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#R1_1Q2MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1_1Characteristic
                         ] ;
        obo:IAO_0000115  "Are the ontology access rights specified and permissions documented? This metric corresponds to the O'FAIRe question R1.1Q2, which assesses FAIR principle R1.1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (Ontology access rights and permissions absent); 4 (Ontology access rights are clearly specified); 7 (Ontology access rights are clearly specified and permissions are documented)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "R1.1Q2" .

