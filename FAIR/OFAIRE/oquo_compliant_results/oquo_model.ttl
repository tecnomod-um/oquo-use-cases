oquo-fair-qm:I2Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata use vocabularies that follow the FAIR principles."@en ;
        rdfs:label       "FAIR I2 FAIR vocabularies characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the resource and its metadata use vocabularies, ontologies and terminologies that themselves comply with the FAIR principles, being documented, identified by globally unique and persistent identifiers, and openly accessible. For an ontology, this refers to the vocabularies it imports or reuses (e.g. for annotations or upper-level classes), whose own FAIRness conditions the interoperability of the ontology."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/i2"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "I2" .

