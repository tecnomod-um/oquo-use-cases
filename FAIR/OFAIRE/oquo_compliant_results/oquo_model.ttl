<https://purl.org/oquo-ofaire#R1_2Q2Metric>
        a                owl:Class ;
        rdfs:comment     "Does an ontology provide information on its general provenance?"@en ;
        rdfs:label       "O'FAIRe R1.2Q2 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1_2Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1_2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#R1_2Q2MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "Does an ontology provide information on its general provenance? This metric corresponds to the O'FAIRe question R1.2Q2, which assesses FAIR principle R1.2. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology provides O property to inform on its general provenance); 2 (The ontology provides 1 property to inform on its general provenance); 4 (The ontology provides 2 properties to inform on its general provenance); 6 (The ontology provides 3 properties to inform on its general provenance)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "R1.2Q2" .

<https://purl.org/oquo-ofaire#F3Q3Metric>
        a                owl:Class ;
        rdfs:comment     "Does that external file explicitly link to the ontology and vice-versa?"@en ;
        rdfs:label       "O'FAIRe F3Q3 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:F3Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F3Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#F3Q3MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "Does that external file explicitly link to the ontology and vice-versa? This metric corresponds to the O'FAIRe question F3Q3, which assesses FAIR principle F3. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No explicit link between the ontology and its metadata and vice-versa); 5 (One explicit link between the ontology and its metadata (but no reciprocal)); 10 (Bidirectional links between the ontology and its metadata)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "F3Q3" .

