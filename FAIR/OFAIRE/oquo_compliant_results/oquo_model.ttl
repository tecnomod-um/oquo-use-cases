<https://purl.org/oquo-ofaire#F4Q2Metric>
        a                owl:Class ;
        rdfs:comment     "Is the ontology registered in multiple open ontology 'repositories'?"@en ;
        rdfs:label       "O'FAIRe F4Q2 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:F4Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F4Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#F4Q2MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "Is the ontology registered in multiple open ontology 'repositories'? This metric corresponds to the O'FAIRe question F4Q2, which assesses FAIR principle F4. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology is registered in 0 ontology repository); 2 (The ontology is registered in 1 ontology repository); 4 (The ontology is registered in 2 ontology repositories); 6 (The ontology is registered in 3 ontology repositories); 8 (The ontology is registered in 4 ontology repositories); 10 (The ontology is registered in 5 or more ontology repositories)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "F4Q2" .

