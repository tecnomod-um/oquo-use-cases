        rdfs:label                   "mapping I2Q1 level 5 -> 100.0"@en ;
        oquo:hasInputScaleCategory   <https://purl.org/oquo-ofaire#I2Q1MetricScaleLevel5> ;
        oquo:hasOutputCardinalValue  "100.0"^^xsd:double .

oquo-fair-qm:F1Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata have a globally unique and persistent identifier."@en ;
        rdfs:label       "FAIR F1 globally unique and persistent identifier characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the resource and its metadata are assigned an identifier that is globally unique, so that it unambiguously refers to that resource and no other, and persistent, so that it keeps resolving to the resource over time. For an ontology, this typically involves a stable ontology IRI, version IRIs and resolvable entity IRIs, for instance through PURL or w3id services, avoiding IRIs bound to local or temporary locations."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/f1"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "F1" .

