                           owl:allValuesFrom  oquo-fair-qm:R1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        obo:IAO_0000115  "How much ontology objects are defined using a property restriction or an equivalent class? This metric corresponds to the O'FAIRe question R1Q5, which assesses FAIR principle R1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 6 (Full credits: the requirement of the question is fulfilled). This question is not implemented in the current version of O'FAIRe, which always gives it 0 credits with the explanation \"This question cannot be evaluated in the repository at this time.\""@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "R1Q5" .

