<https://purl.org/oquo-ofaire#A1Q3Metric>
        a                owl:Class ;
        rdfs:comment     "Do the ontology URI and the external metadata URI (if the metadata are not included in the ontology file), support content negotiation?"@en ;
        rdfs:label       "O'FAIRe A1Q3 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:A1Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#A1Q3MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:A1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "Do the ontology URI and the external metadata URI (if the metadata are not included in the ontology file), support content negotiation? This metric corresponds to the O'FAIRe question A1Q3, which assesses FAIR principle A1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (Ontology and its metadata do not support content negotiation); 3 (Ontology or its metadata support 1 negotiation format); 6 (Ontology or its metadata support 2 negotiation formats); 9 (Ontology or its metadata support 3 negotiation formats); 12 (Ontology or its metadata support 4 negotiation formats); 15 (Ontology and its metadata support 5 negotiation formats); 18 (Ontology and its metadata support 6 negotiation formats); 21 (Ontology and its metadata support 7 negotiation formats); 24 (Ontology and its metadata support 8 or more negotiation formats)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "A1Q3" .

