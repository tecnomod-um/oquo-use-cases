<https://purl.org/oquo-ofaire#ofaire-software-agent>
        a                      owl:NamedIndividual , prov:SoftwareAgent ;
        rdfs:comment           "Software that implements O'FAIRe and assesses the FAIRness of ontologies from their metadata."@en ;
        rdfs:label             "ofaire software agent" ;
        rdfs:seeAlso           <https://hal-lirmm.ccsd.cnrs.fr/lirmm-03630233> ;
        obo:IAO_0000115        "The software implementation of O'FAIRe (Ontology FAIRness Evaluator), a web service that automatically assesses the FAIRness of ontologies, vocabularies and other semantic resources hosted in an OntoPortal repository, such as AgroPortal. It answers a set of questions, each one associated with a FAIR principle, mainly from the metadata of the resource described with the MOD metadata profile, and reports a score for each question, principle and FAIR category, and an overall FAIRness score. It acts as the agent of the evaluations whose results are described with this module."@en ;
        obo:IAO_0000119        "Amdouni, E., Bouazzouni, S. and Jonquet, C. (2022). O'FAIRe: Ontology FAIRness Evaluator in the AgroPortal Semantic Resource Repository. In The Semantic Web: ESWC 2022 Satellite Events, Lecture Notes in Computer Science, vol. 13384. Springer."@en ;
        dc:creator             <https://orcid.org/0000-0002-2069-8739> , <https://orcid.org/0000-0002-2930-5938> , <https://orcid.org/0000-0002-2404-1582> ;
        dc:source              <https://doi.org/10.1007/978-3-031-11609-4_17> ;
        schema:codeRepository  <https://github.com/agroportal/fairness> ;
        foaf:homepage          <http://services.agroportal.lirmm.fr/ofaire/> .

