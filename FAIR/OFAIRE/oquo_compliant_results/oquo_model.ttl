<https://purl.org/oquo-ofaire#R1_2Q5Metric>
        a                owl:Class ;
        rdfs:comment     "Are the ontology latest changes documented?"@en ;
        rdfs:label       "O'FAIRe R1.2Q5 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1_2Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1_2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#R1_2Q5MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "Are the ontology latest changes documented? This metric corresponds to the O'FAIRe question R1.2Q5, which assesses FAIR principle R1.2. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 2 (Full credits: the requirement of the question is fulfilled). This question is not implemented in the current version of O'FAIRe, which always gives it 0 credits with the explanation \"This question cannot be evaluated in the repository at this time.\""@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "R1.2Q5" .

