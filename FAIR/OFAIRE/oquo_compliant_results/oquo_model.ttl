        om-1:rank        20 .

<https://purl.org/oquo-ofaire#A2Q3Metric>
        a                owl:Class ;
        rdfs:comment     "Are the ontology metadata accessible even if no more versions of the ontology are available?"@en ;
        rdfs:label       "O'FAIRe A2Q3 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:A2Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:A2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#A2Q3MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "Are the ontology metadata accessible even if no more versions of the ontology are available? This metric corresponds to the O'FAIRe question A2Q3, which assesses FAIR principle A2. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 4 (The repository provides metadata even if no more versions of the ontology are available)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "A2Q3" .

QualityModel:LowerBest
        a             owl:Thing , owl:NamedIndividual , QualityModel:RankingFunction ;
        rdfs:comment  "A ranking function that denotes that a lower value is better." ;
        rdfs:label    "LowerBest" .

