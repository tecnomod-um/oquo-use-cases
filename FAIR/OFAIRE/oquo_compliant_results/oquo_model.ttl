oquo-fair-qm:R1_1Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata are released with a clear and accessible usage license."@en ;
        rdfs:label       "FAIR R1.1 clear and accessible usage license characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the resource and its metadata are released with a clear and accessible data usage license, so that both humans and machines can determine the conditions under which they can be reused. For ontologies, this means declaring a license in the ontology metadata (e.g. with dcterms:license), preferably by referencing a standard license through its IRI (e.g. a Creative Commons license)."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/r1-1"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "R1.1" .

