oquo-fair-qm:F2Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource is described with rich metadata."@en ;
        rdfs:label       "FAIR F2 rich metadata characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the resource is accompanied by metadata generous enough to support its discovery, even by users who do not know its identifier. Rich metadata include descriptive information such as title, description, creators, keywords, domain or version. For an ontology, this corresponds to the annotations attached to the ontology header and to its entities, preferably expressed with widely used metadata vocabularies (e.g. Dublin Core, DCAT or schema.org)."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/f2"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "F2" .

