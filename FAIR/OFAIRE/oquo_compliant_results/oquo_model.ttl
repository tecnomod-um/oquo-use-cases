oquo-fair-qm:A1_2Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the retrieval protocol supports authentication and authorisation where necessary."@en ;
        rdfs:label       "FAIR A1.2 protocol supports authentication and authorisation characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the communication protocol allows for authentication and authorisation procedures when access to the resource must be restricted, so that the identity of the requester and their permissions can be verified. This subcharacteristic does not penalise openly accessible resources; it ensures that, when restrictions apply, they are implemented through standard, well-defined mechanisms (e.g. HTTPS with OAuth) rather than ad hoc ones."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/a1-2"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "A1.2" .

