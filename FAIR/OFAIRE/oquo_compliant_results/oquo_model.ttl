<https://purl.org/oquo-ofaire#R1_3Q3Metric>
        a                owl:Class ;
        rdfs:comment     "Is the ontology openly and freely available?"@en ;
        rdfs:label       "O'FAIRe R1.3Q3 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#R1_3Q3MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1_3Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1_3Characteristic
                         ] ;
        obo:IAO_0000115  "Is the ontology openly and freely available? This metric corresponds to the O'FAIRe question R1.3Q3, which assesses FAIR principle R1.3. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology is not openly and freely available); 6 (The ontology is openly and freely available)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "R1.3Q3" .

