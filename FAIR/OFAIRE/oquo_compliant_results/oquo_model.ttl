oquo:NominalToNominalScalePointMapping
        a                owl:Class ;
        rdfs:comment     "Represents the mapping of a category of a nominal scale onto a category of another nominal scale." ;
        rdfs:label       "nominal to nominal scale point mapping" ;
        rdfs:subClassOf  oquo:ScalePointMapping ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               om-1:Measurement_scale_category ;
                           owl:onProperty            oquo:hasInputScaleCategory ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               om-1:Measurement_scale_category ;
                           owl:onProperty            oquo:hasOutputScaleCategory ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        obo:IAO_0000112  "The categories pass and fail of the nominal scale of one framework can be converted into the categories ok and error of the nominal scale of another framework, with the mappings pass onto ok and fail onto error." ;
        obo:IAO_0000115  "A scale point mapping that converts a category of an input nominal scale into a category of an output nominal scale. Each mapping has exactly one input scale category (hasInputScaleCategory) and one output scale category (hasOutputScaleCategory). A nominal to nominal scale conversion contains one of these mappings for each category of the input scale, and several input categories may be converted into the same output category. It can be used, for instance, to harmonise the categories used by different evaluation frameworks." .

