oquo:CardinalToOrdinalScalePointMapping
        a                owl:Class ;
        rdfs:comment     "Represents the mapping between a cardinal value in one scale and a ordinal value in another scale." ;
        rdfs:label       "cardinal to ordinal scale point mapping" ;
        rdfs:subClassOf  oquo:ScalePointMapping ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               oquo:Interval ;
                           owl:onProperty            oquo:hasInputCardinalInterval ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] ;
        rdfs:subClassOf  [ a                         owl:Restriction ;
                           owl:onClass               QualityModel:OrdinalScaleItem ;
                           owl:onProperty            oquo:hasOutputScaleCategory ;
                           owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                         ] .

<https://purl.org/oquo-ofaire#A1_1Q2Metric>
        a                owl:Class ;
        rdfs:comment     "Is the ontology access protocol open, free, and universally implementable?"@en ;
        rdfs:label       "O'FAIRe A1.1Q2 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:A1_1Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:A1_1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#A1_1Q2MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "Is the ontology access protocol open, free, and universally implementable? This metric corresponds to the O'FAIRe question A1.1Q2, which assesses FAIR principle A1.1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 4 (The repository access protocols (HTTP/URIs) are open, free and universally implementable)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "A1.1Q2" .

