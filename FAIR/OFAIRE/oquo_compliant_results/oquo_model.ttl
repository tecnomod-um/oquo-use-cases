<https://purl.org/oquo-ofaire#R1Q1Metric>
        a                owl:Class ;
        rdfs:comment     "Does the ontology provide information about how classes or concepts are defined?"@en ;
        rdfs:label       "O'FAIRe R1Q1 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#R1Q1MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1Characteristic
                         ] ;
        obo:IAO_0000115  "Does the ontology provide information about how classes or concepts are defined? This metric corresponds to the O'FAIRe question R1Q1, which assesses FAIR principle R1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology provides 0 property to inform how classes or concepts are defined); 1 (The ontology provides 1 property to inform how classes or concepts are defined); 2 (The ontology provides 2 properties to inform how classes or concepts are defined); 3 (The ontology provides 3 properties to inform how classes or concepts are defined); 4 (The ontology provides 4 properties to inform how classes or concepts are defined); 5 (The ontology provides 5 properties to inform how classes or concepts are defined)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "R1Q1" .

