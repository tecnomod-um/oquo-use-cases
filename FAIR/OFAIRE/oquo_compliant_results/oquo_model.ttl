<https://purl.org/oquo-ofaire#I2Q2Metric>
        a                owl:Class ;
        rdfs:comment     "Does the ontology reuse terms from other FAIR vocabularies (URIs)?"@en ;
        rdfs:label       "O'FAIRe I2Q2 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:I2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:I2Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#I2Q2MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "Does the ontology reuse terms from other FAIR vocabularies (URIs)? This metric corresponds to the O'FAIRe question I2Q2, which assesses FAIR principle I2. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology does not declare reusing other vocabularies); 5 (The ontology declares reusing terms from other vocabularies (independently of their level of FAIRness))."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "I2Q2" .

