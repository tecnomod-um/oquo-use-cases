oquo:RawScale  a         owl:Class ;
        rdfs:label       "raw scale" ;
        rdfs:subClassOf  om-1:Measurement_scale ;
        obo:IAO_0000115  "The raw scale provided by a metric directly without applying any scale."@en .

oquo:OrdinalToCardinalScaleConversion
        a                owl:Class ;
        rdfs:comment     "Defines the conversion from an ordinal scale to a cardinal scale." ;
        rdfs:label       "ordinal to cardinal scale conversion" ;
        rdfs:subClassOf  oquo:ScaleConversion ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasInputScale ;
                           owl:someValuesFrom  om-1:Ordinal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasOutputScale ;
                           owl:someValuesFrom  om-1:Cardinal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasScalePointMapping ;
                           owl:someValuesFrom  oquo:OrdinalToCardinalScalePointMapping
                         ] .

<https://purl.org/oquo-ofaire#I2Q6Metric>
        a                owl:Class ;
        rdfs:comment     "Does the ontology provide metadata information about relation to or influence of other FAIR vocabularies?"@en ;
        rdfs:label       "O'FAIRe I2Q6 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#I2Q6MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:I2Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:I2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        obo:IAO_0000115  "Does the ontology provide metadata information about relation to or influence of other FAIR vocabularies? This metric corresponds to the O'FAIRe question I2Q6, which assesses FAIR principle I2. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology does not declare influential relations to other vocabularies); 2 (The ontology declares influential relations to other vocabularies (independently of their level of FAIRness))."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "I2Q6" .

<https://purl.org/oquo-ofaire#A1_2Q2Metric>
        a                owl:Class ;
        rdfs:comment     "Are the ontology metadata accessible through a protocol that supports authentification and authorization?"@en ;
        rdfs:label       "O'FAIRe A1.2Q2 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:A1_2Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
