oquo:OrdinalToOrdinalScaleConversion
        a                owl:Class ;
        rdfs:comment     "Defines how to convert an ordinal scale into another ordinal scale." ;
        rdfs:label       "ordinal to ordinal scale conversion" ;
        rdfs:subClassOf  oquo:ScaleConversion ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasInputScale ;
                           owl:someValuesFrom  om-1:Ordinal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasOutputScale ;
                           owl:someValuesFrom  om-1:Ordinal_scale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:hasScalePointMapping ;
                           owl:someValuesFrom  oquo:OrdinalToOrdinalScalePointMapping
                         ] .

