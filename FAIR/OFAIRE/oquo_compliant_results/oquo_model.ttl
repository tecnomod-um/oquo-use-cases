<https://purl.org/oquo-ofaire#I3Q1Metric>
        a                owl:Class ;
        rdfs:comment     "Does an ontology provide qualified cross-references to external resources/databases?"@en ;
        rdfs:label       "O'FAIRe I3Q1 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:I3Characteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#I3Q1MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:I3Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        obo:IAO_0000115  "Does an ontology provide qualified cross-references to external resources/databases? This metric corresponds to the O'FAIRe question I3Q1, which assesses FAIR principle I3. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 20 (Full credits: the requirement of the question is fulfilled). This question is not implemented in the current version of O'FAIRe, which always gives it 0 credits with the explanation \"This question cannot be evaluated in the repository at this time.\""@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "I3Q1" .

