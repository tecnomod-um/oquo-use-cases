<https://purl.org/oquo-ofaire#F4Q2MetricScaleToPercentageScaleConversion>
        a                          owl:NamedIndividual , oquo:OrdinalToCardinalScaleConversion ;
        rdfs:comment               "The definition of the conversion between the scales <https://purl.org/oquo-ofaire#F4Q2MetricScale> and <https://purl.org/oquo-fair-qm#PercentageScale>."@en ;
