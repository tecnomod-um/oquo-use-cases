<https://purl.org/oquo-ofaire#R1_2Q3Metric>
        a                owl:Class ;
        rdfs:comment     "Are the accrual methods and policy of the ontology documented?"@en ;
        rdfs:label       "O'FAIRe R1.2Q3 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1_2Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#R1_2Q3MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1_2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        obo:IAO_0000115  "Are the accrual methods and policy of the ontology documented? This metric corresponds to the O'FAIRe question R1.2Q3, which assesses FAIR principle R1.2. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology provides 0 accrual property); 2 (The ontology provides 1 accrual property); 4 (The ontology provides 2 accrual properties); 6 (The ontology provides 3 accrual properties)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "R1.2Q3" .

om-1:Ratio_scale  a      owl:Class ;
        rdfs:comment     "A ratio scale is a quantitative scale where there is a true zero and equal intervals between neighboring points. Unlike on an interval scale, a zero on a ratio scale means there is a total absence of the variable you are measuring." ;
        rdfs:label       "ratio scale"@en ;
        rdfs:subClassOf  om-1:Cardinal_scale ;
        obo:IAO_0000112  "Length, area, and population are examples of ratio scales." .

