oquo-fair-qm:F3Characteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the metadata explicitly include the identifier of the resource they describe."@en ;
        rdfs:label       "FAIR F3 metadata include data identifier characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        obo:IAO_0000115  "Degree to which the metadata explicitly and unambiguously state the identifier of the resource they describe, so that the link between metadata and resource is preserved when they are stored or exchanged separately. For an ontology, this means that metadata records (e.g. in a registry or in a separate metadata file) include the ontology IRI and, where applicable, the version IRI."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/f3"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "F3" .

