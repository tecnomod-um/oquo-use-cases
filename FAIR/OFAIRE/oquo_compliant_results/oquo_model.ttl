<https://purl.org/oquo-ofaire#R1_1Q1Metric>
        a                owl:Class ;
        rdfs:comment     "Is the ontology license clearly specified, with an URI that is resolvable and supports content negotiation?"@en ;
        rdfs:label       "O'FAIRe R1.1Q1 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#R1_1Q1MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1_1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1_1Characteristic
                         ] ;
        obo:IAO_0000115  "Is the ontology license clearly specified, with an URI that is resolvable and supports content negotiation? This metric corresponds to the O'FAIRe question R1.1Q1, which assesses FAIR principle R1.1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (Ontology license absent); 4 (Ontology license present but not a valid URI); 8 (Ontology license present and valid but not resolvable); 12 (Ontology license present, valid, resolvable but with no content negotiation); 15 (Ontology license is clearly specified with a valid and resolvable URI that supports content negotiation)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "R1.1Q1" .

