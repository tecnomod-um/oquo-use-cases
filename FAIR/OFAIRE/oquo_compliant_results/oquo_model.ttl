<https://purl.org/oquo-ofaire#F2Q3Metric>
        a                owl:Class ;
        rdfs:comment     "Is the ontology described with another metadata property with no explicit corresponding MIRO requirement?"@en ;
        rdfs:label       "O'FAIRe F2Q3 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:F2Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:F2Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#F2Q3MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        obo:IAO_0000115  "Is the ontology described with another metadata property with no explicit corresponding MIRO requirement? This metric corresponds to the O'FAIRe question F2Q3, which assesses FAIR principle F2. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology is described with 0 additionnal property); 1 (The ontology is described with 1 additionnal property); 2 (The ontology is described with 2 additionnal properties); 3 (The ontology is described with 3 additionnal properties); 4 (The ontology is described with 4 additionnal properties); 5 (The ontology is described with 5 additionnal properties); 6 (The ontology is described with 6 additionnal properties); 7 (The ontology is described with 7 or more additionnal properties)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "F2Q3" .

