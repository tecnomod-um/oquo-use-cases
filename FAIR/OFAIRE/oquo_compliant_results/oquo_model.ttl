<https://purl.org/oquo-ofaire#R1_2Q4MetricScale>
        a                               owl:NamedIndividual , om-1:Ordinal_scale , oquo:RawScale ;
        rdfs:label                      "O'FAIRe R1.2Q4 metric scale"@en ;
        obo:IAO_0000115                 "Raw scale of the O'FAIRe R1.2Q4 metric: an ordinal scale whose categories are the possible numbers of credits of the question, from 0 to 4."@en ;
        QualityModel:hasRankigFunction  QualityModel:HigherBest ;
        om-1:element                    <https://purl.org/oquo-ofaire#R1_2Q4MetricScaleLevel0> , <https://purl.org/oquo-ofaire#R1_2Q4MetricScaleLevel2> , <https://purl.org/oquo-ofaire#R1_2Q4MetricScaleLevel4> .

<https://purl.org/oquo-ofaire#R1Q3Metric>
        a                owl:Class ;
        rdfs:comment     "How much of the ontology objects are described with labels?"@en ;
        rdfs:label       "O'FAIRe R1Q3 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:R1Characteristic
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#R1Q3MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "How much of the ontology objects are described with labels? This metric corresponds to the O'FAIRe question R1Q3, which assesses FAIR principle R1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 7 (Full credits: the requirement of the question is fulfilled). This question is not implemented in the current version of O'FAIRe, which always gives it 0 credits with the explanation \"This question cannot be evaluated in the repository at this time.\""@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "R1Q3" .

