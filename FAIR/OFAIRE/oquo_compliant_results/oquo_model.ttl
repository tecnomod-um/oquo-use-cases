<https://purl.org/oquo-ofaire#I1Q1Metric>
        a                owl:Class ;
        rdfs:comment     "What is the representation language used for ontology and ontology metadata?"@en ;
        rdfs:label       "O'FAIRe I1Q1 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      oquo:measuresCharacteristicPositively ;
                           owl:someValuesFrom  oquo-fair-qm:I1Characteristic
                         ] ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:I1Characteristic ;
                           owl:onProperty     oquo:measuresCharacteristicPositively
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
                                                                       [ a               owl:Restriction ;
                                                                         owl:hasValue    QualityModel:HigherBest ;
                                                                         owl:onProperty  QualityModel:hasRankigFunction
                                                                       ]
                                                                     )
                                               ]
                         ] ;
        rdfs:subClassOf  [ a               owl:Restriction ;
                           owl:hasValue    <https://purl.org/oquo-ofaire#I1Q1MetricScale> ;
                           owl:onProperty  QualityModel:hasScale
                         ] ;
        obo:IAO_0000115  "What is the representation language used for ontology and ontology metadata? This metric corresponds to the O'FAIRe question I1Q1, which assesses FAIR principle I1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (Ontology knowledge representation language absent); 5 (Ontology and ontology metadata are represented in PDF); 7 (Ontology and ontology metadata are represented in TXT); 9 (Ontology and ontology metadata are represented in CSV); 10 (Ontology and ontology metadata are represented in XML); 11 (Ontology and ontology metadata are represented in OBO); 12 (Ontology and ontology metadata are represented in RDFS); 15 (Ontology and ontology metadata are represented in SKOS); 18 (Ontology and ontology metadata are represented in OWL)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "I1Q1" .

