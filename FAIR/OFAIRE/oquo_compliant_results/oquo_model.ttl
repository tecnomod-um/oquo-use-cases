        a                owl:Class ;
        rdfs:comment     "Is the ontology described with additional 'MIRO should' or 'optional' metadata properties?"@en ;
        rdfs:label       "O'FAIRe F2Q2 metric"@en ;
        rdfs:subClassOf  QualityModel:DerivedMeasure ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasScale ;
                           owl:someValuesFrom  [ a                   owl:Class ;
                                                 owl:intersectionOf  ( oquo:RawScale
