                         ] ;
        obo:IAO_0000115  "Does the ontology provide information about its hierarchy? This metric corresponds to the O'FAIRe question R1Q2, which assesses FAIR principle R1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology provides 0 property to inform about its hierarchy); 1 (The ontology provides 1 property to inform about its hierarchy); 2 (The ontology provides 2 properties to inform about its hierarchy); 3 (The ontology provides 3 properties to inform about its hierarchy)."@en ;
        obo:IAO_0000119  "O'FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"@en ;
        rdf1:acronym     "R1Q2" .

