oquo-fair-qm:ReusableCharacteristic
        a                owl:Class ;
        rdfs:comment     "Degree to which the resource and its metadata are described well enough to be reused."@en ;
        rdfs:label       "FAIR reusable characteristic"@en ;
        rdfs:subClassOf  QualityModel:QualityCharacteristic ;
        rdfs:subClassOf  [ a                  owl:Restriction ;
                           owl:allValuesFrom  oquo-fair-qm:R1Characteristic ;
                           owl:onProperty     QualityModel:hasSubCharacteristic
                         ] ;
        rdfs:subClassOf  [ a                   owl:Restriction ;
                           owl:onProperty      QualityModel:hasSubCharacteristic ;
                           owl:someValuesFrom  oquo-fair-qm:R1Characteristic
                         ] ;
        obo:IAO_0000115  "Degree to which the resource and its metadata are described well enough to be replicated and/or combined in different settings, which is the ultimate goal of FAIR. Reusability requires a plurality of accurate and relevant attributes, including a clear usage licence, detailed provenance and compliance with domain-relevant community standards. It is assessed through the subcharacteristic R1 and its refinements R1.1 to R1.3."@en ;
        obo:IAO_0000119  "GO FAIR Foundation, https://www.gofair.foundation/fair-principles"@en , "Wilkinson, M. D. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data, 3:160018. https://doi.org/10.1038/sdata.2016.18"@en ;
        dc:source        <https://doi.org/10.1038/sdata.2016.18> ;
        rdf1:acronym     "R" .

