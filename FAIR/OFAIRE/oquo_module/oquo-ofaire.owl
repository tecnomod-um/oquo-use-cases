    <!-- https://purl.org/oquo-ofaire#CreditLevel -->

    <owl:Class rdf:about="https://purl.org/oquo-ofaire#CreditLevel">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#OrdinalScaleItem"/>
        <obo:IAO_0000115 xml:lang="en">Category of the ordinal scale of an O&apos;FAIRe metric, corresponding to one of the possible numbers of credits that O&apos;FAIRe can give to a question. Its rank is the number of credits, so that the categories of a scale are ordered from the lowest to the highest number of credits, and the quality values of the metric, which are the credits returned by O&apos;FAIRe, correspond to the category with the same rank.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">Possible credit level of an O&apos;FAIRe question.</rdfs:comment>
        <rdfs:label xml:lang="en">O&apos;FAIRe credit level</rdfs:label>
    </owl:Class>
    


