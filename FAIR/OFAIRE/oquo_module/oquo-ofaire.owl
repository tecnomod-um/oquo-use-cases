     -->

    


    <!-- https://purl.org/oquo-ofaire#A1Q1Metric -->

    <owl:Class rdf:about="https://purl.org/oquo-ofaire#A1Q1Metric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-ofaire#A1Q1MetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Does the ontology URI and other identifiers, if exist, resolve to the ontology? This metric corresponds to the O&apos;FAIRe question A1Q1, which assesses FAIR principle A1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology provides 0 resolvable identifier); 3 (The ontology provides 1 resolvable identifier); 6 (The ontology provides 2 resolvable identifiers).</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">O&apos;FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md</obo:IAO_0000119>
        <rdf1:acronym>A1Q1</rdf1:acronym>
        <rdfs:comment xml:lang="en">Does the ontology URI and other identifiers, if exist, resolve to the ontology?</rdfs:comment>
        <rdfs:label xml:lang="en">O&apos;FAIRe A1Q1 metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo-ofaire#A1Q2Metric -->

    <owl:Class rdf:about="https://purl.org/oquo-ofaire#A1Q2Metric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-ofaire#A1Q2MetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Does the ontology URI (if metadata is included in the ontology file) or the external metadata URI resolve to the metadata record? This metric corresponds to the O&apos;FAIRe question A1Q2, which assesses FAIR principle A1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 7 (The repository provides an external metadata URI which resolves to the metadata record).</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">O&apos;FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md</obo:IAO_0000119>
        <rdf1:acronym>A1Q2</rdf1:acronym>
        <rdfs:comment xml:lang="en">Does the ontology URI (if metadata is included in the ontology file) or the external metadata URI resolve to the metadata record?</rdfs:comment>
        <rdfs:label xml:lang="en">O&apos;FAIRe A1Q2 metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo-ofaire#A1Q3Metric -->

    <owl:Class rdf:about="https://purl.org/oquo-ofaire#A1Q3Metric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://purl.org/oquo#RawScale"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-ofaire#A1Q3MetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Do the ontology URI and the external metadata URI (if the metadata are not included in the ontology file), support content negotiation? This metric corresponds to the O&apos;FAIRe question A1Q3, which assesses FAIR principle A1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (Ontology and its metadata do not support content negotiation); 3 (Ontology or its metadata support 1 negotiation format); 6 (Ontology or its metadata support 2 negotiation formats); 9 (Ontology or its metadata support 3 negotiation formats); 12 (Ontology or its metadata support 4 negotiation formats); 15 (Ontology and its metadata support 5 negotiation formats); 18 (Ontology and its metadata support 6 negotiation formats); 21 (Ontology and its metadata support 7 negotiation formats); 24 (Ontology and its metadata support 8 or more negotiation formats).</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">O&apos;FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md</obo:IAO_0000119>
        <rdf1:acronym>A1Q3</rdf1:acronym>
        <rdfs:comment xml:lang="en">Do the ontology URI and the external metadata URI (if the metadata are not included in the ontology file), support content negotiation?</rdfs:comment>
        <rdfs:label xml:lang="en">O&apos;FAIRe A1Q3 metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo-ofaire#A1Q4Metric -->

    <owl:Class rdf:about="https://purl.org/oquo-ofaire#A1Q4Metric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:someValuesFrom>
