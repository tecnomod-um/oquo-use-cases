                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1_1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1_1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-ofaire#A1_1Q1MetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Is the ontology relying on HTTP/URIs for its identification and access mechanisms? This metric corresponds to the O&apos;FAIRe question A1.1Q1, which assesses FAIR principle A1.1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 20 (The repository uses HTTP/URIs for identification and access mechanisms).</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">O&apos;FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md</obo:IAO_0000119>
        <rdf1:acronym>A1.1Q1</rdf1:acronym>
        <rdfs:comment xml:lang="en">Is the ontology relying on HTTP/URIs for its identification and access mechanisms?</rdfs:comment>
        <rdfs:label xml:lang="en">O&apos;FAIRe A1.1Q1 metric</rdfs:label>
    </owl:Class>
    


