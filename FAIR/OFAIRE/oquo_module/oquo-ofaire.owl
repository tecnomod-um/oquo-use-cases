            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Is the ontology access protocol open, free, and universally implementable? This metric corresponds to the O&apos;FAIRe question A1.1Q2, which assesses FAIR principle A1.1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (No credits: the requirement of the question is not fulfilled, or the question could not be evaluated); 4 (The repository access protocols (HTTP/URIs) are open, free and universally implementable).</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">O&apos;FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md</obo:IAO_0000119>
        <rdf1:acronym>A1.1Q2</rdf1:acronym>
        <rdfs:comment xml:lang="en">Is the ontology access protocol open, free, and universally implementable?</rdfs:comment>
        <rdfs:label xml:lang="en">O&apos;FAIRe A1.1Q2 metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo-ofaire#A1_1Q3Metric -->

    <owl:Class rdf:about="https://purl.org/oquo-ofaire#A1_1Q3Metric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
