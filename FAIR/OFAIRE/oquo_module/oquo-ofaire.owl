                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasRankigFunction"/>
                                <owl:hasValue rdf:resource="http://purl.org/net/QualityModel#HigherBest"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/oquo#measuresCharacteristicPositively"/>
                <owl:allValuesFrom rdf:resource="https://purl.org/oquo-fair-qm#A1Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-ofaire#A1Q4MetricScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Are the ontology and its metadata accessible through another standard protocol such as SPARQL? This metric corresponds to the O&apos;FAIRe question A1Q4, which assesses FAIR principle A1. Its raw value is the number of credits obtained in the question, measured on an ordinal scale with the following levels: 0 (The ontology is not accessible through a SPARQL endpoint); 6 (The ontology declares being accessible through a SPARQL endpoint).</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">O&apos;FAIRe, https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md</obo:IAO_0000119>
        <rdf1:acronym>A1Q4</rdf1:acronym>
        <rdfs:comment xml:lang="en">Are the ontology and its metadata accessible through another standard protocol such as SPARQL?</rdfs:comment>
        <rdfs:label xml:lang="en">O&apos;FAIRe A1Q4 metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo-ofaire#A1_1Q1Metric -->

    <owl:Class rdf:about="https://purl.org/oquo-ofaire#A1_1Q1Metric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
