<?xml version="1.0"?>
<rdf:RDF xmlns="https://purl.org/oquo-ofaire#"
     xml:base="https://purl.org/oquo-ofaire"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:om-1="http://www.wurvoc.org/vocabularies/om-1.8/"
     xmlns:oquo="https://purl.org/oquo#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdf1="http://www.cropontology.org/rdf/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:QualityModel="http://purl.org/net/QualityModel#"
     xmlns:oquo-fair-qm="https://purl.org/oquo-fair-qm#">
    <owl:Ontology rdf:about="https://purl.org/oquo-ofaire">
        <owl:versionIRI rdf:resource="https://purl.org/oquo-ofaire/v1.0.0"/>
        <owl:imports rdf:resource="https://purl.org/oquo-fair-qm"/>
        <obo:IAO_0000116 xml:lang="en">The metrics, their credit levels and their explanations are generated from the questions.config.json file of O&apos;FAIRe (https://github.com/agroportal/fairness, MIT License). O&apos;FAIRe gives 0 credits to a question whenever it is not fulfilled or cannot be evaluated, so every scale includes a category with 0 credits even if O&apos;FAIRe does not declare it.</obo:IAO_0000116>
        <dc:contributor>Francisco Abad-Navarro</dc:contributor>
        <dc:creator>Francisco Abad-Navarro</dc:creator>
        <dc:description xml:lang="en">OQUO module that integrates O&apos;FAIRe (Ontology FAIRness Evaluator), a framework that assesses the FAIRness of ontologies and semantic resources hosted in OntoPortal repositories, with the OQUO FAIR quality model. The module defines one metric for each of the 61 O&apos;FAIRe questions and associates it with the FAIR subcharacteristic it assesses. The raw value of each metric is the number of credits obtained in the question, measured on an ordinal scale whose categories are the possible credit levels of the question, ranked by their number of credits. The module also defines the conversions of these ordinal scales into the percentage scale of the FAIR quality model, which assign to each level its credits divided by the maximum credits of the question, as a percentage. 10 of the questions are not implemented in the current version of O&apos;FAIRe, which always gives them 0 credits.</dc:description>
        <dc:publisher>Universidad de Murcia</dc:publisher>
        <dc:source xml:lang="en">Amdouni, E., Bouazzouni, S., Jonquet, C. (2022). O&apos;FAIRe makes you an offer: Metadata-based Automatic FAIRness Assessment for Ontologies and Semantic Resources. International Journal of Metadata, Semantics and Ontologies, Inderscience. https://hal.archives-ouvertes.fr/lirmm-03630233</dc:source>
        <dc:title xml:lang="en">OQUO O&apos;FAIRe module</dc:title>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-05</terms:created>
        <terms:license rdf:resource="http://www.apache.org/licenses/LICENSE-2.0"/>
        <vann:preferredNamespacePrefix>oquo-ofaire</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://purl.org/oquo-ofaire#</vann:preferredNamespaceUri>
        <rdfs:seeAlso rdf:resource="https://github.com/agroportal/fairness"/>
        <rdfs:seeAlso rdf:resource="https://github.com/agroportal/fairness/blob/master/doc/results/FAIR-questions.md"/>
    </owl:Ontology>
    


