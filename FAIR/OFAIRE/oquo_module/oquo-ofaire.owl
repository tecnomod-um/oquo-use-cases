    <!-- https://purl.org/oquo-ofaire#ofaire-software-agent -->

    <owl:NamedIndividual rdf:about="https://purl.org/oquo-ofaire#ofaire-software-agent">
        <rdf:type rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
        <obo:IAO_0000115 xml:lang="en">The software implementation of O&apos;FAIRe (Ontology FAIRness Evaluator), a web service that automatically assesses the FAIRness of ontologies, vocabularies and other semantic resources hosted in an OntoPortal repository, such as AgroPortal. It answers a set of questions, each one associated with a FAIR principle, mainly from the metadata of the resource described with the MOD metadata profile, and reports a score for each question, principle and FAIR category, and an overall FAIRness score. It acts as the agent of the evaluations whose results are described with this module.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Amdouni, E., Bouazzouni, S. and Jonquet, C. (2022). O&apos;FAIRe: Ontology FAIRness Evaluator in the AgroPortal Semantic Resource Repository. In The Semantic Web: ESWC 2022 Satellite Events, Lecture Notes in Computer Science, vol. 13384. Springer.</obo:IAO_0000119>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-2069-8739"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-2404-1582"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-2930-5938"/>
        <dc:source rdf:resource="https://doi.org/10.1007/978-3-031-11609-4_17"/>
        <schema:codeRepository rdf:resource="https://github.com/agroportal/fairness"/>
        <rdfs:comment xml:lang="en">Software that implements O&apos;FAIRe and assesses the FAIRness of ontologies from their metadata.</rdfs:comment>
        <rdfs:label>ofaire software agent</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hal-lirmm.ccsd.cnrs.fr/lirmm-03630233"/>
        <foaf:homepage rdf:resource="http://services.agroportal.lirmm.fr/ofaire/"/>
    </owl:NamedIndividual>
    


